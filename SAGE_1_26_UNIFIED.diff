+package com.pineapple.sage;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Debug;
+
+import java.io.File;
+import java.util.Locale;
+
+/** Persistent, user-visible health and benchmark record for tablet Brain and Dell Forge routing. */
+final class SageBrainHealth {
+    enum Status {
+        OFF,
+        LOADING,
+        LOCAL_READY,
+        DELL_READY,
+        THINKING_LOCAL,
+        THINKING_DELL,
+        FALLBACK_USED,
+        TIMED_OUT,
+        ERROR
+    }
+
+    private static final String PREFS = "sage_brain_health_v1";
+    private SageBrainHealth() {}
+
+    static void setStatus(Context context, Status status, String route, String stage,
+                          String error) {
+        prefs(context).edit()
+                .putString("status", status.name())
+                .putString("active_route", clean(route))
+                .putString("timeout_stage", clean(stage))
+                .putString("exact_error", clean(error))
+                .putLong("updated_at_ms", System.currentTimeMillis())
+                .apply();
+        SageDiagnostics.appendEvent(context, "BRAIN HEALTH",
+                "status=" + status.name() + " route=" + clean(route)
+                        + " stage=" + clean(stage) + " error=" + clean(error));
+    }
+
+    static void recordModel(Context context, String name, File file, String sha256) {
+        String modelName = clean(name);
+        long size = file != null && file.isFile() ? file.length() : 0L;
+        prefs(context).edit()
+                .putString("model_name", modelName)
+                .putString("model_file", file == null ? "not selected" : file.getName())
+                .putString("quantization", inferQuantization(modelName))
+                .putLong("file_size", size)
+                .putString("verification_hash", clean(sha256))
+                .apply();
+    }
+
+    static void loadStarted(Context context) {
+        prefs(context).edit().putLong("load_started_ms", System.currentTimeMillis()).apply();
+        setStatus(context, Status.LOADING, "tablet Brain", "load", "");
+    }
+
+    static void loadFinished(Context context) {
+        SharedPreferences p = prefs(context);
+        long start = p.getLong("load_started_ms", 0L);
+        p.edit().putLong("load_duration_ms",
+                start <= 0L ? -1L : Math.max(0L, System.currentTimeMillis() - start)).apply();
+        setStatus(context, Status.LOCAL_READY, "tablet Brain", "ready", "");
+    }
+
+    static void promptStarted(Context context) {
+        prefs(context).edit()
+                .putLong("prompt_started_ms", System.currentTimeMillis())
+                .putLong("first_token_latency_ms", -1L)
+                .putBoolean("cancelled", false)
+                .apply();
+        setStatus(context, Status.THINKING_LOCAL, "tablet Brain", "generation", "");
+    }
+
+    static void generationFinished(Context context, String generatedText,
+                                   long firstTokenLatencyMs, int generatedTokens,
+                                   long generationDurationMs) {
+        long duration = generationDurationMs > 0L ? generationDurationMs : -1L;
+        int tokens = Math.max(0, generatedTokens);
+        float speed = duration <= 0L ? -1f : (tokens * 1000f) / duration;
+        prefs(context).edit()
+                .putLong("first_token_latency_ms", firstTokenLatencyMs)
+                .putLong("generation_duration_ms", duration)
+                .putInt("generated_tokens", tokens)
+                .putFloat("generation_tokens_per_second", speed)
+                .apply();
+        setStatus(context, Status.LOCAL_READY, "tablet Brain", "complete", "");
+    }
+
+    static void cancelled(Context context, String stage) {
+        prefs(context).edit().putBoolean("cancelled", true).apply();
+        setStatus(context, Status.TIMED_OUT, "fallback", stage, "Watchdog cancelled generation");
+    }
+
+    static void fallback(Context context, String stage, String reason) {
+        setStatus(context, Status.FALLBACK_USED, "fallback", stage, reason);
+    }
+
+    static String indicator(Context context) {
+        SharedPreferences p = prefs(context);
+        return p.getString("status", Status.OFF.name())
+                + " • " + p.getString("active_route", "command engine");
+    }
+
+    static String report(Context context) {
+        SharedPreferences p = prefs(context);
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        ActivityManager manager = (ActivityManager) context.getSystemService(Context.ACTIVITY_SERVICE);
+        if (manager != null) manager.getMemoryInfo(memory);
+        Debug.MemoryInfo processMemory = new Debug.MemoryInfo();
+        Debug.getMemoryInfo(processMemory);
+        long firstToken = p.getLong("first_token_latency_ms", -1L);
+        String firstTokenText = firstToken < 0L
+                ? "not measured"
+                : firstToken + " ms";
+        float speed = p.getFloat("generation_tokens_per_second", -1f);
+        return "Brain status: " + p.getString("status", Status.OFF.name())
+                + "\nActive route: " + p.getString("active_route", "command engine")
+                + "\nModel name: " + p.getString("model_name", "not selected")
+                + "\nModel file: " + p.getString("model_file", "not selected")
+                + "\nQuantization: " + p.getString("quantization", "unknown")
+                + "\nFile size: " + p.getLong("file_size", 0L) + " bytes"
+                + "\nVerification hash: " + p.getString("verification_hash", "not recorded")
+                + "\nLoad duration: " + p.getLong("load_duration_ms", -1L) + " ms"
+                + "\nPrompt start: " + p.getLong("prompt_started_ms", 0L)
+                + "\nFirst-token latency: " + firstTokenText
+                + "\nGeneration duration: " + p.getLong("generation_duration_ms", -1L) + " ms"
+                + "\nGeneration speed: "
+                + (speed < 0f ? "not measured" : String.format(Locale.US, "%.2f tokens/s", speed))
+                + "\nGenerated token count: " + p.getInt("generated_tokens", 0)
+                + "\nAvailable RAM: " + memory.availMem + " bytes"
+                + "\nProcess RAM usage: " + (processMemory.getTotalPss() * 1024L) + " bytes"
+                + "\nCancellation state: " + (p.getBoolean("cancelled", false) ? "cancelled" : "not cancelled")
+                + "\nTimeout/error stage: " + p.getString("timeout_stage", "none")
+                + "\nExact error: " + p.getString("exact_error", "none");
+    }
+
+    private static String inferQuantization(String name) {
+        String upper = clean(name).toUpperCase(Locale.US);
+        java.util.regex.Matcher match = java.util.regex.Pattern
+                .compile("(Q[2-8](?:_[A-Z0-9]+)?)").matcher(upper);
+        return match.find() ? match.group(1) : "unknown/custom GGUF";
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String clean(String value) {
+        return value == null ? "" : value.replace('\n', ' ').trim();
+    }
+}
