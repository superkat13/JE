+package com.pineapple.sage;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+public class SageMediaInspectorActivity extends Activity {
+    private SageMediaSessionBridge bridge;
+    private TextView report;
+    private TextView status;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Sage Media Inspector");
+        bridge = new SageMediaSessionBridge(this);
+        setContentView(build());
+        refresh();
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("Media Inspector", 28));
+        root.addView(text("What this tool does: reads active Android MediaSession metadata and uses its direct play, pause, next, and previous controls. Android media keys are the fallback; accessibility is not the primary route.", 14));
+        root.addView(text("How to use it: enable Sage notification access, start media, press Refresh, then choose an available control.", 14));
+        root.addView(text("Required permission: Android notification-listener access for other apps' MediaSessions.", 14));
+        root.addView(text("Example voice commands: “Sage, pause media.” “Sage, next track.”", 14));
+        status = text("Ready.", 14);
+        root.addView(status);
+        report = text("", 14);
+        report.setTextIsSelectable(true);
+        root.addView(report);
+        Button refresh = button("Refresh active media"); refresh.setOnClickListener(v -> refresh()); root.addView(refresh);
+        Button play = button("Play"); play.setOnClickListener(v -> control("play")); root.addView(play);
+        Button pause = button("Pause"); pause.setOnClickListener(v -> control("pause")); root.addView(pause);
+        Button next = button("Next"); next.setOnClickListener(v -> control("next")); root.addView(next);
+        Button previous = button("Previous"); previous.setOnClickListener(v -> control("previous")); root.addView(previous);
+        Button access = button("Open Android notification access");
+        access.setOnClickListener(v -> startActivity(new Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)));
+        root.addView(access);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void refresh() {
+        SageMediaSessionBridge.Snapshot snapshot = bridge.snapshot();
+        report.setText("Active media application: " + snapshot.packageName
+                + "\nTitle: " + snapshot.title
+                + "\nPlayback state: " + snapshot.state
+                + "\nActive playback: " + snapshot.activePlayback
+                + "\nAvailable MediaSession controls: " + snapshot.controls()
+                + (snapshot.error.isEmpty() ? "" : "\nAccess note: " + snapshot.error));
+    }
+
+    private void control(String action) {
+        boolean sent = bridge.control(action);
+        status.setText(sent ? "Sent “" + action + "” through Android media APIs."
+                : "No controllable MediaSession or Android media route was available.");
+        refresh();
+    }
+    private Button button(String value) { Button b = new Button(this); b.setText(value); b.setAllCaps(false); return b; }
+    private TextView text(String value, int size) { TextView t = new TextView(this); t.setText(value); t.setTextSize(size); return t; }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+}
