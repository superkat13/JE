+
+    private boolean addStableOverlayContainer() {
+        WindowManager.LayoutParams params = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                android.graphics.PixelFormat.TRANSLUCENT);
+        params.gravity = Gravity.TOP | Gravity.START;
+        try {
+            windowManager.addView(stableOverlayContainer, params);
+            numberOverlayViews.add(stableOverlayContainer);
+            return true;
+        } catch (RuntimeException error) {
+            SageDiagnostics.appendEvent(this, "OVERLAY RENDER",
+                    "stable container failed: " + error.getClass().getSimpleName());
+            stableOverlayContainer = null;
+            numberedTargets.clear();
+            gridTargets.clear();
+            return false;
+        }
+    }
+
+    private void scheduleStableOverlayTimeout() {
