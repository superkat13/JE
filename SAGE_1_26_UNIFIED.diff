+package com.pineapple.sage;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import com.google.mlkit.vision.codescanner.GmsBarcodeScanner;
+import com.google.mlkit.vision.codescanner.GmsBarcodeScannerOptions;
+import com.google.mlkit.vision.codescanner.GmsBarcodeScanning;
+import com.google.mlkit.vision.barcode.common.Barcode;
+
+public class SageQrScannerActivity extends Activity {
+    private TextView status;
+    private TextView result;
+    private Button copy;
+    private Button open;
+    private String decoded = "";
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Sage QR Scanner");
+        setContentView(build());
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("QR Scanner", 28));
+        root.addView(text("What this tool does: opens Google's on-device camera scanner and returns only decoded QR content to Sage.", 14));
+        root.addView(text("How to use it: press Scan QR, point the camera at one code, and review the decoded text. Links never open without a second confirmation.", 14));
+        root.addView(text("Required permission: camera access is handled by the Google Play services scanner surface; Sage receives the decoded result, not camera frames.", 14));
+        root.addView(text("Example voice command: “Sage, open the QR scanner.”", 14));
+        Button scan = button("Scan QR through camera");
+        scan.setOnClickListener(v -> scan());
+        root.addView(scan);
+        status = text("Ready.", 14);
+        root.addView(status);
+        result = text("", 14);
+        result.setTextIsSelectable(true);
+        root.addView(result);
+        copy = button("Copy decoded content");
+        copy.setEnabled(false);
+        copy.setOnClickListener(v -> copy());
+        root.addView(copy);
+        open = button("Review and open decoded link");
+        open.setEnabled(false);
+        open.setOnClickListener(v -> confirmOpen());
+        root.addView(open);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void scan() {
+        status.setText("Opening camera scanner… Use its Back button to cancel.");
+        GmsBarcodeScannerOptions options = new GmsBarcodeScannerOptions.Builder()
+                .setBarcodeFormats(Barcode.FORMAT_QR_CODE)
+                .enableAutoZoom()
+                .build();
+        GmsBarcodeScanner scanner = GmsBarcodeScanning.getClient(this, options);
+        scanner.startScan()
+                .addOnSuccessListener(barcode -> {
+                    decoded = barcode.getRawValue() == null ? "" : barcode.getRawValue().trim();
+                    if (decoded.isEmpty()) {
+                        status.setText("QR decoded, but it contained no readable text.");
+                        return;
+                    }
+                    status.setText("QR decoded. Review it before taking any action.");
+                    result.setText(decoded);
+                    copy.setEnabled(true);
+                    open.setEnabled(isHttpLink(decoded));
+                    SageDiagnostics.appendEvent(this, "QR", "decoded length=" + decoded.length());
+                })
+                .addOnCanceledListener(() -> status.setText("QR scan cancelled."))
+                .addOnFailureListener(error -> {
+                    String detail = error.getClass().getSimpleName() + ": " + String.valueOf(error.getMessage());
+                    status.setText("QR scanner failed: " + detail);
+                    SageDiagnostics.recordError(this, "QR scanner: " + detail);
+                });
+    }
+
+    private void confirmOpen() {
+        if (!isHttpLink(decoded)) return;
+        new AlertDialog.Builder(this)
+                .setTitle("Open decoded link?")
+                .setMessage(decoded + "\n\nAndroid will choose the receiving app. Sage will not send anything else.")
+                .setNegativeButton("Cancel", null)
+                .setPositiveButton("Open link", (dialog, which) -> {
+                    try {
+                        startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(decoded)));
+                        SageDiagnostics.appendEvent(this, "QR", "owner approved link open");
+                    } catch (Exception error) {
+                        status.setText("Android could not open the link: " + error.getClass().getSimpleName());
+                    }
+                }).show();
+    }
+
+    private void copy() {
+        ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard != null) clipboard.setPrimaryClip(ClipData.newPlainText("QR content", decoded));
+    }
+    private static boolean isHttpLink(String value) {
+        try {
+            Uri uri = Uri.parse(value);
+            return ("https".equalsIgnoreCase(uri.getScheme()) || "http".equalsIgnoreCase(uri.getScheme()))
+                    && uri.getHost() != null && !uri.getHost().trim().isEmpty();
