+package com.pineapple.sage;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+public class SageBrainTestActivity extends Activity {
+    private static final long LOAD_TIMEOUT_MS = 15000L;
+    private static final long GENERATION_TIMEOUT_MS = 30000L;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private SageBrainManager brain;
+    private TextView status;
+    private TextView report;
+    private Button cancel;
+    private long generation;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Test Sage Brain");
+        brain = SageBrainManager.get(this);
+        setContentView(build());
+        refresh();
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("Test Sage Brain", 28));
+        root.addView(text("What this tool does: safely preloads the selected local GGUF model and runs one deterministic health prompt while recording load and generation stages.", 14));
+        root.addView(text("How to use it: choose a model in Sage Commander, then press Run deterministic Brain test. The watchdog cancels a stuck stage and returns a visible fallback.", 14));
+        root.addView(text("Required permission: local model-file access already granted through Sage's private storage. Dell routing requires an approved Sage Forge pairing.", 14));
+        root.addView(text("Example voice command: “Sage, test your brain.”", 14));
+        status = text("Idle", 16);
+        root.addView(status);
+        Button run = button("Run deterministic Brain test");
+        run.setOnClickListener(v -> runTest());
+        root.addView(run);
+        cancel = button("Cancel Brain test");
+        cancel.setEnabled(false);
+        cancel.setOnClickListener(v -> cancel("owner_cancelled"));
+        root.addView(cancel);
+        Button refresh = button("Refresh persistent Brain report");
+        refresh.setOnClickListener(v -> refresh());
+        root.addView(refresh);
+        report = text("", 13);
+        report.setTextIsSelectable(true);
+        root.addView(report);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void runTest() {
+        generation++;
+        final long run = generation;
+        cancel.setEnabled(true);
+        if (!brain.canAnswer()) {
+            SageBrainHealth.fallback(this, "configuration",
+                    "No enabled local GGUF model is available");
+            status.setText("[fallback] Brain test cannot start: choose and enable a GGUF model.");
+            cancel.setEnabled(false);
+            refresh();
+            return;
+        }
+        if (brain.isReady()) {
+            startGeneration(run);
+            return;
+        }
+        status.setText("[tablet Brain] LOADING — watchdog 15 seconds");
+        Runnable timeout = () -> {
+            if (run != generation || brain.isReady()) return;
+            cancel("loading_timeout");
+            status.setText("[fallback] Model loading timed out and was cancelled.");
+        };
+        handler.postDelayed(timeout, LOAD_TIMEOUT_MS);
+        brain.prepareAsync(new SageBrainManager.LoadCallback() {
+            @Override public void onStatus(String value) {
+                if (run == generation) status.setText("[tablet Brain] " + value);
+            }
+            @Override public void onReady(String value) {
+                if (run != generation) return;
+                handler.removeCallbacks(timeout);
+                SageBrainHealth.loadFinished(SageBrainTestActivity.this);
+                startGeneration(run);
+            }
+            @Override public void onError(String value) {
+                if (run != generation) return;
+                handler.removeCallbacks(timeout);
+                SageBrainHealth.setStatus(SageBrainTestActivity.this,
+                        SageBrainHealth.Status.ERROR, "tablet Brain", "load", value);
+                status.setText("[fallback] Load failed: " + value);
+                cancel.setEnabled(false);
+                refresh();
+            }
+        });
+    }
+
+    private void startGeneration(long run) {
+        status.setText("[tablet Brain] THINKING_LOCAL — watchdog 30 seconds");
+        Runnable timeout = () -> {
+            if (run != generation) return;
+            cancel("generation_timeout");
+            status.setText("[fallback] Generation timed out and was cancelled.");
+        };
+        handler.postDelayed(timeout, GENERATION_TIMEOUT_MS);
+        brain.askAsync("Answer with one short sentence confirming the Sage Brain health test.",
+                new SageBrainManager.ReplyCallback() {
+                    @Override public void onStatus(String value) {
+                        if (run == generation) status.setText("[tablet Brain] " + value);
+                    }
+                    @Override public void onReply(SageBrainManager.Reply reply) {
+                        if (run != generation) return;
+                        handler.removeCallbacks(timeout);
+                        status.setText("[tablet Brain] " + reply.text);
+                        cancel.setEnabled(false);
+                        refresh();
+                    }
+                    @Override public void onError(String value) {
+                        if (run != generation) return;
+                        handler.removeCallbacks(timeout);
+                        SageBrainHealth.fallback(SageBrainTestActivity.this,
+                                "generation", value);
+                        status.setText("[fallback] " + value);
+                        cancel.setEnabled(false);
+                        refresh();
+                    }
+                });
+    }
+
+    private void cancel(String stage) {
+        generation++;
+        handler.removeCallbacksAndMessages(null);
+        brain.cancelCurrentRequest();
+        SageBrainHealth.cancelled(this, stage);
+        cancel.setEnabled(false);
+        refresh();
+    }
+
+    private void refresh() { if (report != null) report.setText(SageBrainHealth.report(this)); }
+    @Override protected void onDestroy() { generation++; handler.removeCallbacksAndMessages(null); super.onDestroy(); }
+    private Button button(String value) { Button b = new Button(this); b.setText(value); b.setAllCaps(false); return b; }
+    private TextView text(String value, int size) { TextView t = new TextView(this); t.setText(value); t.setTextSize(size); return t; }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+}
