--- sage_build_v1_25_baseline/app/src/main/java/com/pineapple/sage/SageVoiceCommandTesterActivity.java	1969-12-31 18:00:00.000000000 -0600
+++ sage_build/app/src/main/java/com/pineapple/sage/SageVoiceCommandTesterActivity.java	2026-07-31 18:55:23.818886464 -0500
@@ -0,0 +1,162 @@
+package com.pineapple.sage;
+
+import android.Manifest;
+import android.app.Activity;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.speech.RecognitionListener;
+import android.speech.RecognizerIntent;
+import android.speech.SpeechRecognizer;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.Locale;
+
+public class SageVoiceCommandTesterActivity extends Activity {
+    private static final int MIC_PERMISSION = 12602;
+    private SpeechRecognizer recognizer;
+    private TextView status;
+    private TextView report;
+    private Button execute;
+    private String selectedFinal = "";
+    private long startedAtMs;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Sage Voice Command Tester");
+        setContentView(build());
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("Voice Command Tester", 28));
+        root.addView(text("What this tool does: records one deliberate phrase, shows partials for display, and analyzes only the recognizer's final callback. It never runs the phrase automatically.", 14));
+        root.addView(text("How to use it: press Record one test phrase, speak once, review the raw candidates and route, then press Execute only if you want Sage to run it.", 14));
+        root.addView(text("Required permission: microphone.", 14));
+        root.addView(text("Example voice command: “Sage, open the voice command tester.”", 14));
+        Button record = button("Record one deliberate test phrase");
+        record.setOnClickListener(v -> startTest());
+        root.addView(record);
+        status = text("Idle. Nothing will execute until you press Execute.", 14);
+        root.addView(status);
+        report = text("", 13);
+        report.setTextIsSelectable(true);
+        root.addView(report);
+        execute = button("Execute selected final transcript");
+        execute.setEnabled(false);
+        execute.setOnClickListener(v -> executeSelected());
+        root.addView(execute);
+        Button cancel = button("Cancel recording");
+        cancel.setOnClickListener(v -> stopRecognizer("Cancelled by owner."));
+        root.addView(cancel);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void startTest() {
+        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            requestPermissions(new String[]{Manifest.permission.RECORD_AUDIO}, MIC_PERMISSION);
+            return;
+        }
+        stopRecognizer("");
+        selectedFinal = "";
+        execute.setEnabled(false);
+        if (!SpeechRecognizer.isRecognitionAvailable(this)) {
+            status.setText("Android SpeechRecognizer is unavailable.");
+            return;
+        }
+        recognizer = SpeechRecognizer.createSpeechRecognizer(this);
+        startedAtMs = System.currentTimeMillis();
+        recognizer.setRecognitionListener(new RecognitionListener() {
+            @Override public void onReadyForSpeech(Bundle params) { status.setText("Listening for one test phrase…"); }
+            @Override public void onBeginningOfSpeech() { status.setText("Hearing test phrase…"); }
+            @Override public void onRmsChanged(float rmsdB) { }
+            @Override public void onBufferReceived(byte[] buffer) { }
+            @Override public void onEndOfSpeech() { status.setText("Finalizing test transcript…"); }
+            @Override public void onError(int error) {
+                long latency = System.currentTimeMillis() - startedAtMs;
+                report.setText("Raw candidates: []\nSelected final transcript: none\nConfidence: unavailable\nNormalization: \nMatched command: none\nRoute: fallback\nRejection reason: recognizer_error_" + error + "\nLatency: " + latency + " ms");
+                stopRecognizer("Test recording stopped with Android error " + error + ".");
+            }
+            @Override public void onResults(Bundle results) {
+                ArrayList<String> candidates = results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
+                float[] confidence = results.getFloatArray(SpeechRecognizer.CONFIDENCE_SCORES);
+                int selected = select(candidates, confidence);
+                selectedFinal = selected < 0 ? "" : candidates.get(selected).trim();
+                float score = selected < 0 || confidence == null || selected >= confidence.length ? -1f : confidence[selected];
+                SageCommandPreview.Result preview = SageCommandPreview.classify(selectedFinal,
+                        SageBrainManager.get(SageVoiceCommandTesterActivity.this).canAnswer());
+                long latency = System.currentTimeMillis() - startedAtMs;
+                report.setText("Raw candidates: " + String.valueOf(candidates)
+                        + "\nSelected final transcript: " + (selectedFinal.isEmpty() ? "none" : selectedFinal)
+                        + "\nConfidence: " + score
+                        + "\nNormalization: " + preview.normalized
+                        + "\nMatched command: " + preview.matchedCommand
+                        + "\nRoute: " + preview.route
+                        + "\nRejection reason: " + (preview.rejectionReason.isEmpty() ? "none" : preview.rejectionReason)
+                        + "\nLatency: " + latency + " ms");
+                SageDiagnostics.appendEvent(SageVoiceCommandTesterActivity.this, "VOICE TEST",
+                        "final=" + preview.normalized + " route=" + preview.route + " latency_ms=" + latency);
+                stopRecognizer("Final transcript ready. Review it before Execute.");
+                execute.setEnabled(!selectedFinal.isEmpty());
+            }
+            @Override public void onPartialResults(Bundle partials) {
+                ArrayList<String> values = partials.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
+                status.setText("Partial (display only, never executed): " + String.valueOf(values));
+            }
+            @Override public void onEvent(int eventType, Bundle params) { }
+        });
+        Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.US.toLanguageTag());
+        intent.putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true);
+        intent.putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 10);
+        recognizer.startListening(intent);
+    }
+
+    private static int select(ArrayList<String> values, float[] scores) {
+        if (values == null || values.isEmpty()) return -1;
+        int best = 0;
+        if (scores != null && scores.length > 0)
+            for (int i = 1; i < values.size() && i < scores.length; i++)
+            if (scores[i] > scores[best]) best = i;
+        return best;
+    }
+
+    private void executeSelected() {
+        if (selectedFinal.isEmpty()) return;
+        Intent service = new Intent(this, SageVoiceService.class)
+                .setAction(SageVoiceService.ACTION_TYPED_COMMAND)
+                .putExtra(SageVoiceService.EXTRA_COMMAND, selectedFinal);
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) startForegroundService(service);
+        else startService(service);
+        status.setText("Execute pressed. Sent the selected final transcript to Sage.");
+        execute.setEnabled(false);
+    }
+
+    private void stopRecognizer(String message) {
+        if (recognizer != null) {
+            try { recognizer.cancel(); } catch (RuntimeException ignored) { }
+            recognizer.destroy(); recognizer = null;
+        }
+        if (!message.isEmpty()) status.setText(message);
+    }
+    @Override public void onRequestPermissionsResult(int request, String[] permissions, int[] grants) {
+        super.onRequestPermissionsResult(request, permissions, grants);
+        if (request == MIC_PERMISSION && grants.length > 0 && grants[0] == PackageManager.PERMISSION_GRANTED) startTest();
+        else if (request == MIC_PERMISSION) status.setText("Microphone permission denied; no phrase recorded.");
+    }
+    @Override protected void onDestroy() { stopRecognizer(""); super.onDestroy(); }
+    private Button button(String value) { Button b = new Button(this); b.setText(value); b.setAllCaps(false); return b; }
+    private TextView text(String value, int size) { TextView t = new TextView(this); t.setText(value); t.setTextSize(size); return t; }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+}
