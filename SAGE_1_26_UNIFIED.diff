+
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.Locale;
+
+public class SageFileHasherActivity extends Activity implements SageOperation.Listener {
+    private static final int PICK_FILE = 12601;
+    private TextView status;
+    private TextView result;
+    private ProgressBar progress;
+    private Button cancel;
+    private Button copy;
+    private Button share;
+    private SageOperation operation;
+    private String resultText = "";
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Sage File Hasher");
+        setContentView(build());
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("File Hasher", 28));
+        root.addView(text("What this tool does: reads one owner-selected file locally and calculates its SHA-256 plus exact byte size.", 14));
+        root.addView(text("How to use it: choose a file, wait for completion, then copy or share the text result. Cancel stops the read immediately.", 14));
+        root.addView(text("Required permission: temporary read access granted by Android's file picker.", 14));
+        root.addView(text("Example voice command: “Sage, open the file hasher.”", 14));
+        Button choose = button("Choose file and calculate SHA-256");
+        choose.setOnClickListener(v -> choose());
+        root.addView(choose);
+        progress = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
+        progress.setMax(1000);
+        root.addView(progress);
+        status = text("No file selected.", 14);
+        root.addView(status);
+        cancel = button("Cancel hashing");
+        cancel.setEnabled(false);
+        cancel.setOnClickListener(v -> { if (operation != null) operation.cancel(); });
+        root.addView(cancel);
+        result = text("", 13);
+        result.setTextIsSelectable(true);
+        root.addView(result);
+        copy = button("Copy result");
+        copy.setEnabled(false);
+        copy.setOnClickListener(v -> copyResult());
+        root.addView(copy);
+        share = button("Share result");
+        share.setEnabled(false);
+        share.setOnClickListener(v -> shareResult());
+        root.addView(share);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void choose() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        startActivityForResult(intent, PICK_FILE);
+    }
+
+    @Override protected void onActivityResult(int request, int response, Intent data) {
+        super.onActivityResult(request, response, data);
+        if (request == PICK_FILE && response == RESULT_OK && data != null
+                && data.getData() != null) hash(data.getData());
+    }
+
+    private void hash(Uri uri) {
+        cancel.setEnabled(true);
+        copy.setEnabled(false);
+        share.setEnabled(false);
+        resultText = "";
+        progress.setProgress(0);
+        operation = new SageOperation(this, "file SHA-256");
+        operation.start(session -> {
+            long expected = querySize(uri);
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            long total = 0L;
+            try (InputStream input = getContentResolver().openInputStream(uri)) {
+                if (input == null) throw new Exception("Android could not open the selected file");
+                byte[] buffer = new byte[128 * 1024];
+                int count;
+                while ((count = input.read(buffer)) >= 0) {
+                    session.checkCancelled();
+                    if (count == 0) continue;
+                    digest.update(buffer, 0, count);
+                    total += count;
+                    int done = expected > 0L ? (int) Math.min(1000L, total * 1000L / expected) : 0;
+                    session.progress("Hashing " + total + " bytes", done, 1000);
+                }
+            }
+            StringBuilder hex = new StringBuilder();
+            for (byte value : digest.digest()) hex.append(String.format(Locale.US, "%02x", value));
+            return "SHA-256: " + hex + "\nFile size: " + total + " bytes";
+        }, this);
+    }
+
+    private long querySize(Uri uri) {
+        try (Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.SIZE);
+                if (index >= 0 && !cursor.isNull(index)) return cursor.getLong(index);
+            }
+        } catch (Exception ignored) { }
+        return -1L;
+    }
+
+    @Override public void onProgress(String stage, int completed, int total, long elapsed) {
+        status.setText(stage + " • " + elapsed + " ms");
+        progress.setProgress(total <= 0 ? 0 : completed * 1000 / total);
+    }
+    @Override public void onComplete(String value, long elapsed) {
+        cancel.setEnabled(false); progress.setProgress(1000); resultText = value;
+        result.setText(value); status.setText("Hash complete • " + elapsed + " ms");
+        copy.setEnabled(true); share.setEnabled(true);
+    }
+    @Override public void onError(String detail, long elapsed) {
+        cancel.setEnabled(false); status.setText("Hash stopped: " + detail + " • " + elapsed + " ms");
+    }
+
+    private void copyResult() {
+        ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+        if (clipboard != null) clipboard.setPrimaryClip(ClipData.newPlainText("Sage SHA-256", resultText));
+    }
+    private void shareResult() {
+        Intent shareIntent = new Intent(Intent.ACTION_SEND);
+        shareIntent.setType("text/plain");
+        shareIntent.putExtra(Intent.EXTRA_TEXT, resultText);
+        startActivity(Intent.createChooser(shareIntent, "Share SHA-256 result"));
+    }
+    private Button button(String value) { Button b = new Button(this); b.setText(value); b.setAllCaps(false); return b; }
+    private TextView text(String value, int size) { TextView t = new TextView(this); t.setText(value); t.setTextSize(size); return t; }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+}
