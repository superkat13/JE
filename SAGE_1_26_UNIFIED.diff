+                .getLong(NUMBER_OVERLAY_TIMEOUT_KEY, DEFAULT_NUMBER_OVERLAY_TIMEOUT_MS);
+        if (timeoutMs > 0L) mainHandler.postDelayed(clearNumberOverlayRunnable, timeoutMs);
