+++ sage_build/app/src/main/java/com/pineapple/sage/SageMediaSessionBridge.java	2026-07-31 18:35:30.642924282 -0500
@@ -0,0 +1,174 @@
+package com.pineapple.sage;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.media.AudioManager;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.MediaSessionManager;
+import android.media.session.PlaybackState;
+import android.view.KeyEvent;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Direct MediaSession inspection/control plus bounded command-capture pause and restoration. */
+final class SageMediaSessionBridge {
+    static final class Snapshot {
+        final String packageName;
+        final String title;
+        final String state;
+        final long actions;
+        final boolean activePlayback;
+        final String error;
+
+        Snapshot(String pkg, String title, String state, long actions,
+                 boolean activePlayback, String error) {
+            this.packageName = pkg;
+            this.title = title;
+            this.state = state;
+            this.actions = actions;
+            this.activePlayback = activePlayback;
+            this.error = error;
+        }
+
+        String controls() {
+            List<String> available = new ArrayList<>();
+            if ((actions & PlaybackState.ACTION_PLAY) != 0L) available.add("play");
+            if ((actions & PlaybackState.ACTION_PAUSE) != 0L) available.add("pause");
+            if ((actions & PlaybackState.ACTION_SKIP_TO_NEXT) != 0L) available.add("next");
+            if ((actions & PlaybackState.ACTION_SKIP_TO_PREVIOUS) != 0L) available.add("previous");
+            return available.isEmpty() ? "none reported" : available.toString();
+        }
+    }
+
+    private final Context context;
+    private final List<MediaController> pausedForCapture = new ArrayList<>();
+    private AudioManager.OnAudioFocusChangeListener focusListener;
+
+    SageMediaSessionBridge(Context context) {
+        this.context = context.getApplicationContext();
+    }
+
+    Snapshot snapshot() {
+        List<MediaController> controllers = controllers();
+        if (controllers.isEmpty()) {
+            AudioManager audio = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+            boolean active = audio != null && audio.isMusicActive();
+            return new Snapshot("unavailable", "unavailable",
+                    active ? "active audio without visible MediaSession" : "no active playback",
+                    0L, active,
+                    active ? "Enable Sage notification access for MediaSession identity" : "");
+        }
+        MediaController controller = controllers.get(0);
+        PlaybackState playback = controller.getPlaybackState();
+        int code = playback == null ? PlaybackState.STATE_NONE : playback.getState();
+        long actions = playback == null ? 0L : playback.getActions();
+        MediaMetadata metadata = controller.getMetadata();
+        String title = metadata == null ? "title unavailable"
+                : String.valueOf(metadata.getText(MediaMetadata.METADATA_KEY_TITLE));
+        if ("null".equals(title)) title = "title unavailable";
+        return new Snapshot(controller.getPackageName(), title, stateName(code), actions,
+                isPlayingState(code), "");
+    }
+
+    boolean isPlaybackActive() {
+        Snapshot current = snapshot();
+        return current.activePlayback;
+    }
+
+    /** Pauses only sessions that were playing and remembers exactly which sessions to restore. */
+    void pauseOrDuckForAuthorizedCapture() {
+        restoreAfterCapture();
+        for (MediaController controller : controllers()) {
+            PlaybackState state = controller.getPlaybackState();
+            if (state != null && isPlayingState(state.getState())
+                    && (state.getActions() & PlaybackState.ACTION_PAUSE) != 0L) {
+                controller.getTransportControls().pause();
+                pausedForCapture.add(controller);
+            }
+        }
+        AudioManager audio = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+        if (audio != null) {
+            focusListener = change -> { };
+            audio.requestAudioFocus(focusListener, AudioManager.STREAM_MUSIC,
+                    AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK);
+        }
+        SageDiagnostics.appendEvent(context, "MEDIA SOURCE",
+                "authorized capture paused_sessions=" + pausedForCapture.size());
+    }
+
+    void restoreAfterCapture() {
+        for (MediaController controller : new ArrayList<>(pausedForCapture)) {
+            try {
+                PlaybackState state = controller.getPlaybackState();
+                if (state == null || state.getState() != PlaybackState.STATE_PLAYING) {
+                    controller.getTransportControls().play();
+                }
+            } catch (RuntimeException ignored) { }
+        }
+        pausedForCapture.clear();
+        AudioManager audio = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+        if (audio != null && focusListener != null) audio.abandonAudioFocus(focusListener);
+        focusListener = null;
+    }
+
+    boolean control(String action) {
+        List<MediaController> controllers = controllers();
+        if (!controllers.isEmpty()) {
+            MediaController.TransportControls controls = controllers.get(0).getTransportControls();
+            if ("play".equals(action)) controls.play();
+            else if ("pause".equals(action)) controls.pause();
+            else if ("next".equals(action)) controls.skipToNext();
+            else if ("previous".equals(action)) controls.skipToPrevious();
+            else return false;
+            SageDiagnostics.appendEvent(context, "MEDIA CONTROL", action + " via MediaSession");
+            return true;
+        }
+        int key = "play".equals(action) || "pause".equals(action)
+                ? KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE
+                : "next".equals(action) ? KeyEvent.KEYCODE_MEDIA_NEXT
+                : "previous".equals(action) ? KeyEvent.KEYCODE_MEDIA_PREVIOUS : -1;
+        AudioManager audio = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
+        if (key < 0 || audio == null) return false;
+        audio.dispatchMediaKeyEvent(new KeyEvent(KeyEvent.ACTION_DOWN, key));
+        audio.dispatchMediaKeyEvent(new KeyEvent(KeyEvent.ACTION_UP, key));
+        SageDiagnostics.appendEvent(context, "MEDIA CONTROL", action + " via Android media key");
+        return true;
+    }
+
+    private List<MediaController> controllers() {
+        MediaSessionManager manager = (MediaSessionManager)
+                context.getSystemService(Context.MEDIA_SESSION_SERVICE);
+        if (manager == null) return Collections.emptyList();
+        try {
+            ComponentName listener = new ComponentName(context, SageNotificationListener.class);
+            return manager.getActiveSessions(listener);
+        } catch (SecurityException error) {
+            return Collections.emptyList();
+        }
+    }
+
+    private static boolean isPlayingState(int state) {
+        return state == PlaybackState.STATE_PLAYING
+                || state == PlaybackState.STATE_BUFFERING
+                || state == PlaybackState.STATE_CONNECTING
+                || state == PlaybackState.STATE_FAST_FORWARDING
+                || state == PlaybackState.STATE_REWINDING;
+    }
+
+    private static String stateName(int state) {
+        switch (state) {
+            case PlaybackState.STATE_PLAYING: return "PLAYING";
+            case PlaybackState.STATE_PAUSED: return "PAUSED";
+            case PlaybackState.STATE_BUFFERING: return "BUFFERING";
+            case PlaybackState.STATE_CONNECTING: return "CONNECTING";
+            case PlaybackState.STATE_STOPPED: return "STOPPED";
+            case PlaybackState.STATE_ERROR: return "ERROR";
+            case PlaybackState.STATE_SKIPPING_TO_NEXT: return "SKIPPING_TO_NEXT";
+            case PlaybackState.STATE_SKIPPING_TO_PREVIOUS: return "SKIPPING_TO_PREVIOUS";
+            default: return "NONE";
+        }
+    }
+}
