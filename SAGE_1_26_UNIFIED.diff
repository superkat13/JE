--- sage_build_v1_25_baseline/app/src/main/java/com/pineapple/sage/SageCommandPreview.java	1969-12-31 18:00:00.000000000 -0600
+++ sage_build/app/src/main/java/com/pineapple/sage/SageCommandPreview.java	2026-07-31 18:39:16.302917130 -0500
@@ -0,0 +1,44 @@
+package com.pineapple.sage;
+
+/** Non-executing command classifier used only by Voice Command Tester. */
+final class SageCommandPreview {
+    static final class Result {
+        final String normalized;
+        final String matchedCommand;
+        final String route;
+        final String rejectionReason;
+        Result(String normalized, String matchedCommand, String route, String rejectionReason) {
+            this.normalized = normalized;
+            this.matchedCommand = matchedCommand;
+            this.route = route;
+            this.rejectionReason = rejectionReason;
+        }
+    }
+
+    static Result classify(String value, boolean brainAvailable) {
+        String n = SageConversationStateMachine.normalize(value);
+        if (n.isEmpty()) return new Result(n, "none", "fallback", "empty_final");
+        String[] exact = {
+                "home", "go home", "back", "go back", "recents", "recent apps",
+                "show notifications", "scroll up", "scroll down", "show targets",
+                "show numbers", "refine", "pause", "play", "next", "previous",
+                "open workbench", "open toolbelt", "test your brain"
+        };
+        for (String command : exact) {
+            if (n.equals(command) || n.equals("sage " + command))
+                return new Result(n, command, "command engine", "");
+        }
+        String[] prefixes = {
+                "open ", "tap ", "click ", "press ", "choose ", "select ",
+                "type ", "write ", "search ", "find ", "remember ", "translate ",
+                "volume ", "number ", "show "
+        };
+        for (String prefix : prefixes) {
+            if (n.startsWith(prefix) || n.startsWith("sage " + prefix))
+                return new Result(n, prefix.trim() + " …", "command engine", "");
+        }
+        return brainAvailable
+                ? new Result(n, "no deterministic command", "tablet Brain", "no_deterministic_match")
+                : new Result(n, "no deterministic command", "fallback", "no_deterministic_match");
+    }
+}
diff -ruN '--exclude=build' '--exclude=.gradle' '--exclude=.cxx' '--exclude=assets' '--exclude=third_party' sage_build_v1_25_baseline/app/src/main/java/com/pineapple/sage/SageConversationStateMachine.java sage_build/app/src/main/java/com/pineapple/sage/SageConversationStateMachine.java
--- sage_build_v1_25_baseline/app/src/main/java/com/pineapple/sage/SageConversationStateMachine.java	1969-12-31 18:00:00.000000000 -0600
+++ sage_build/app/src/main/java/com/pineapple/sage/SageConversationStateMachine.java	2026-07-31 18:50:30.086895774 -0500
@@ -0,0 +1,251 @@
+package com.pineapple.sage;
+
+import java.util.Locale;
+
+/**
+ * Single authority for Sage wake and command-turn lifecycle decisions.
+ *
+ * Android recognizers may deliver the same final callback more than once, deliver a callback
+ * after cancellation, or send a partial followed by an error.  This class intentionally has no
+ * Android dependency so those failure modes can be regression-tested on the JVM.
+ */
+final class SageConversationStateMachine {
+    enum State {
+        IDLE_WAKE,
+        WAKE_ACCEPTED,
+        COMMAND_LISTENING,
+        FINALIZING,
+        DISPATCHING,
+        SPEAKING,
+        ECHO_GUARD,
+        CONVERSATION_LISTENING,
+        CLOSED,
+        ERROR
+    }
+
+    enum SpeechSource { LIKELY_USER, SAGE_TTS, DEVICE_MEDIA, UNKNOWN }
+
+    static final class Decision {
+        final boolean executable;
+        final long turnId;
+        final long callbackGeneration;
+        final String rawCandidates;
+        final String selectedCandidate;
+        final float confidence;
+        final String normalized;
+        final String match;
+        final String route;
+        final String rejectionReason;
+        final SpeechSource source;
+
+        Decision(boolean executable, long turnId, long callbackGeneration,
+                 String rawCandidates, String selectedCandidate, float confidence,
+                 String normalized, String match, String route, String rejectionReason,
+                 SpeechSource source) {
+            this.executable = executable;
+            this.turnId = turnId;
+            this.callbackGeneration = callbackGeneration;
+            this.rawCandidates = clean(rawCandidates);
+            this.selectedCandidate = clean(selectedCandidate);
+            this.confidence = confidence;
+            this.normalized = normalize(normalized);
+            this.match = clean(match);
+            this.route = clean(route);
+            this.rejectionReason = clean(rejectionReason);
+            this.source = source == null ? SpeechSource.UNKNOWN : source;
+        }
+    }
+
+    private long turnSequence;
+    private long activeTurnId;
+    private long activeGeneration;
+    private long lastWakeAcceptedAtMs = -1L;
+    private long lastExecutableAtMs = -1L;
+    private String lastExecutableNormalized = "";
+    private boolean completed;
+    private boolean retryUsed;
+    private boolean authorizedByWakeOrPushToTalk;
+    private State state = State.CLOSED;
+
+    synchronized State state() { return state; }
+    synchronized long turnId() { return activeTurnId; }
+    synchronized long generation() { return activeGeneration; }
+    synchronized boolean isCompleted() { return completed; }
+
+    synchronized long beginWake(long callbackGeneration, long nowMs) {
+        activeTurnId = ++turnSequence;
+        activeGeneration = callbackGeneration;
+        completed = false;
+        retryUsed = false;
+        authorizedByWakeOrPushToTalk = false;
+        state = State.IDLE_WAKE;
+        return activeTurnId;
+    }
+
+    synchronized Decision acceptWake(String raw, String normalized,
+                                     long callbackGeneration, long nowMs,
+                                     long debounceWindowMs) {
+        String value = normalize(normalized);
+        if (callbackGeneration != activeGeneration) {
+            return reject(raw, raw, -1f, value, callbackGeneration,
+                    "wake_phrase", "wake", "stale_recognizer_generation",
+                    SpeechSource.UNKNOWN);
+        }
+        if (completed || state != State.IDLE_WAKE) {
+            return reject(raw, raw, -1f, value, callbackGeneration,
+                    "wake_phrase", "wake", "turn_already_completed",
+                    SpeechSource.UNKNOWN);
+        }
+        if (lastWakeAcceptedAtMs >= 0L
+                && nowMs - lastWakeAcceptedAtMs < Math.max(0L, debounceWindowMs)) {
+            completed = true;
+            state = State.CLOSED;
+            return reject(raw, raw, -1f, value, callbackGeneration,
+                    "wake_phrase", "wake", "wake_debounce",
+                    SpeechSource.UNKNOWN);
+        }
+        completed = true;
+        lastWakeAcceptedAtMs = nowMs;
+        authorizedByWakeOrPushToTalk = true;
+        state = State.WAKE_ACCEPTED;
+        return accept(raw, raw, -1f, value, callbackGeneration,
+                "wake_phrase", "wake", SpeechSource.LIKELY_USER);
+    }
+
+    synchronized long beginCommand(long callbackGeneration, long nowMs,
+                                   boolean authorized, boolean activeMedia) {
+        activeTurnId = ++turnSequence;
+        activeGeneration = callbackGeneration;
+        completed = false;
+        retryUsed = false;
+        authorizedByWakeOrPushToTalk = authorized;
+        state = State.COMMAND_LISTENING;
+        return activeTurnId;
+    }
+
+    synchronized Decision partial(String rawCandidates, String selected,
+                                  float confidence, long callbackGeneration) {
+        String normalized = normalize(selected);
+        if (callbackGeneration != activeGeneration) {
+            return reject(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "", "ui_only", "stale_recognizer_generation",
+                    SpeechSource.UNKNOWN);
+        }
+        return reject(rawCandidates, selected, confidence, normalized,
+                callbackGeneration, "", "ui_only", "partial_transcript_ui_only",
+                SpeechSource.UNKNOWN);
+    }
+
+    synchronized Decision finalTranscript(String rawCandidates, String selected,
+                                          float confidence, long callbackGeneration,
+                                          long nowMs, long deduplicationWindowMs,
+                                          String recentTtsFingerprint,
+                                          long recentTtsFinishedAtMs,
+                                          long echoFingerprintWindowMs,
+                                          boolean activeMedia) {
+        String normalized = normalize(selected);
+        if (callbackGeneration != activeGeneration) {
+            return reject(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "", "", "stale_recognizer_generation",
+                    SpeechSource.UNKNOWN);
+        }
+        if (completed || (state != State.COMMAND_LISTENING
+                && state != State.CONVERSATION_LISTENING)) {
+            return reject(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "", "", "turn_already_completed",
+                    SpeechSource.UNKNOWN);
+        }
+        state = State.FINALIZING;
+        if (normalized.isEmpty()) {
+            return rejectAndClose(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "", "", "empty_final",
+                    SpeechSource.UNKNOWN);
+        }
+        if (lastExecutableAtMs >= 0L && normalized.equals(lastExecutableNormalized)
+                && nowMs - lastExecutableAtMs < Math.max(0L, deduplicationWindowMs)) {
+            return rejectAndClose(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "duplicate", "", "duplicate_transcript_window",
+                    SpeechSource.UNKNOWN);
+        }
+        String tts = normalize(recentTtsFingerprint);
+        boolean withinEchoWindow = recentTtsFinishedAtMs > 0L
+                && nowMs - recentTtsFinishedAtMs <= Math.max(0L, echoFingerprintWindowMs);
+        if (withinEchoWindow && fingerprintsMatch(normalized, tts)) {
+            return rejectAndClose(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "tts_fingerprint", "", "speaker_echo",
+                    SpeechSource.SAGE_TTS);
+        }
+        if (activeMedia && !authorizedByWakeOrPushToTalk) {
+            return rejectAndClose(rawCandidates, selected, confidence, normalized,
+                    callbackGeneration, "active_media", "", "media_without_authorized_wake",
+                    SpeechSource.DEVICE_MEDIA);
+        }
+        completed = true;
+        lastExecutableNormalized = normalized;
+        lastExecutableAtMs = nowMs;
+        state = State.DISPATCHING;
+        return accept(rawCandidates, selected, confidence, normalized,
+                callbackGeneration, "executable_final", "command_engine",
+                SpeechSource.LIKELY_USER);
+    }
+
+    synchronized boolean retryIncomplete(long newCallbackGeneration) {
+        if (completed || retryUsed || (state != State.COMMAND_LISTENING
+                && state != State.FINALIZING)) {
+            return false;
+        }
+        retryUsed = true;
+        activeGeneration = newCallbackGeneration;
+        state = State.COMMAND_LISTENING;
+        return true;
+    }
+
+    synchronized void markSpeaking() { state = State.SPEAKING; }
+    synchronized void markEchoGuard() { state = State.ECHO_GUARD; }
+    synchronized void beginConversationListening() {
+        completed = false;
+        state = State.CONVERSATION_LISTENING;
+    }
+    synchronized void close() { completed = true; state = State.CLOSED; }
+    synchronized void error() { completed = true; state = State.ERROR; }
+
+    private Decision rejectAndClose(String raw, String selected, float confidence,
+                                    String normalized, long generation, String match,
+                                    String route, String reason, SpeechSource source) {
+        completed = true;
+        state = State.CLOSED;
+        return reject(raw, selected, confidence, normalized, generation,
+                match, route, reason, source);
+    }
+
+    private Decision accept(String raw, String selected, float confidence,
+                            String normalized, long generation, String match,
+                            String route, SpeechSource source) {
+        return new Decision(true, activeTurnId, generation, raw, selected, confidence,
+                normalized, match, route, "", source);
+    }
+
+    private Decision reject(String raw, String selected, float confidence,
+                            String normalized, long generation, String match,
+                            String route, String reason, SpeechSource source) {
+        return new Decision(false, activeTurnId, generation, raw, selected, confidence,
+                normalized, match, route, reason, source);
+    }
+
+    static boolean fingerprintsMatch(String left, String right) {
+        String a = normalize(left);
+        String b = normalize(right);
+        if (a.isEmpty() || b.isEmpty()) return false;
+        if (a.equals(b)) return true;
+        return (a.length() >= 5 && b.contains(a)) || (b.length() >= 5 && a.contains(b));
+    }
+
+    static String normalize(String value) {
+        return clean(value).toLowerCase(Locale.US)
+                .replaceAll("[^a-z0-9 ]", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+
+    private static String clean(String value) { return value == null ? "" : value.trim(); }
+}
