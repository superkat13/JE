+package com.pineapple.sage;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+public class SageToolbeltActivity extends Activity {
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle("Sage Toolbelt");
+        setContentView(build());
+    }
+
+    private View build() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(18), dp(18), dp(18), dp(18));
+        scroll.addView(root);
+        root.addView(text("SAGE TOOLBELT", 30));
+        root.addView(text("Functional owner-controlled tools. Every operation reports real progress, errors, permissions, and approval boundaries.", 15));
+        card(root, "Package Inspector",
+                "Inspect APK package, version, minimum Android, permissions, signer and SHA-256; compare installed identity; use Android's confirmed installer handoff.",
+                SagePackageCenterActivity.class);
+        card(root, "QR Scanner",
+                "Scan one QR through the camera, display decoded content, and confirm before opening any link.",
+                SageQrScannerActivity.class);
+        card(root, "File Hasher",
+                "Calculate SHA-256 and byte size locally, with progress, cancellation, copy, and share.",
+                SageFileHasherActivity.class);
+        card(root, "Network Snapshot",
+                "After owner confirmation, conservatively discover only the current private subnet; cancel, save, and compare new or missing devices.",
+                SageNetworkActivity.class);
+        card(root, "Media Inspector",
+                "Inspect active MediaSession app, title, playback state and controls; use direct play, pause, next, and previous APIs.",
+                SageMediaInspectorActivity.class);
+        card(root, "Voice Command Tester",
+                "Record one deliberate phrase and inspect candidates, final, confidence, normalization, match, route, rejection and latency without execution.",
+                SageVoiceCommandTesterActivity.class);
+        SageAppearance.apply(this, scroll, root);
+        return scroll;
+    }
+
+    private void card(LinearLayout root, String title, String detail, Class<?> activity) {
+        Button button = new Button(this);
+        button.setAllCaps(false);
+        button.setText(title + "\n" + detail);
+        button.setMinHeight(dp(88));
+        button.setOnClickListener(v -> startActivity(new Intent(this, activity)));
+        root.addView(button);
+    }
+    private TextView text(String value, int size) { TextView t = new TextView(this); t.setText(value); t.setTextSize(size); return t; }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+}
