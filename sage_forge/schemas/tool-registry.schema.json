{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sage.local/schemas/tool-registry.schema.json",
  "title": "Sage Forge trusted tool registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id", "display_name", "purpose", "supported_platform",
        "implementation", "input_schema", "output_schema", "required_permissions",
        "risk_level", "confirmation_policy", "timeout_seconds", "concurrency_limit",
        "network_scope", "data_leaves_device", "audit_requirements"
      ],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "supported_platform": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["windows", "linux", "darwin", "android"]}
        },
        "implementation": {
          "type": "string",
          "pattern": "^trusted:[a-zA-Z_][a-zA-Z0-9_.]*$",
          "description": "A local registry binding; never supplied by an agent definition."
        },
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"},
        "required_permissions": {"type": "array", "items": {"type": "string"}},
        "risk_level": {"enum": ["low", "moderate", "high", "prohibited"]},
        "confirmation_policy": {"enum": ["always", "first_use", "never"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "concurrency_limit": {"type": "integer", "minimum": 1, "maximum": 8},
        "network_scope": {
          "enum": ["none", "local_device", "local_subnet", "explicit_private_target", "repository_only"]
        },
        "data_leaves_device": {"type": "boolean"},
        "audit_requirements": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  }
}
