<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sage" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0E1116</item>
        <item name="android:navigationBarColor">#0E1116</item>
        <item name="android:statusBarColor">#0E1116</item>
        <item name="android:colorAccent">#A9D5B2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Crash-safe warm launch surface; the Sage home applies the owner's saved appearance. -->
    <style name="Theme.Sage.Home" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F7F4EE</item>
        <item name="android:navigationBarColor">#F7F4EE</item>
        <item name="android:statusBarColor">#F7F4EE</item>
        <item name="android:colorAccent">#688B6F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
