+    private void startNativeWakeRecognition() {
+        if (stopRequested || speaking || commandListening || commandStartPending
+                || nativeWakeListening || wakeListening) {
+            return;
+        }
+        try {
+            speechRecognizer = SpeechRecognizer.createSpeechRecognizer(this);
+            speechRecognizer.setRecognitionListener(new RecognitionListener() {
+                @Override
+                public void onReadyForSpeech(Bundle params) {
+                    if (!nativeWakeListening) {
+                        return;
+                    }
+                    String status = lastWakePreview.isEmpty()
+                            ? "Waiting for Sage — high accuracy"
+                            : "Waiting for Sage — last heard: " + lastWakePreview;
+                    broadcastStatus(status);
+                    updateNotification("Say Sage");
+                }
+
+                @Override
+                public void onBeginningOfSpeech() {
+                    if (nativeWakeListening) {
+                        broadcastStatus("Checking wake word");
+                    }
+                }
+
+                @Override public void onRmsChanged(float rmsdB) { }
+                @Override public void onBufferReceived(byte[] buffer) { }
+                @Override public void onEndOfSpeech() { }
+
+                @Override
+                public void onError(int error) {
+                    if (!nativeWakeListening) {
+                        return;
+                    }
+                    nativeWakeListening = false;
+                    destroyCommandRecognizer();
+                    if (isNativeWakeFailure(error)) {
+                        nativeWakeFailures++;
+                    }
+                    if (!stopRequested && !speaking && !commandListening) {
+                        long retryDelay = error == SpeechRecognizer.ERROR_RECOGNIZER_BUSY ? 900L : 350L;
+                        startWakeListening(retryDelay);
+                    }
+                }
+
+                @Override
+                public void onResults(Bundle results) {
+                    if (!nativeWakeListening) {
+                        return;
+                    }
+                    if (handleNativeWakeResults(results, true)) {
+                        return;
+                    }
+                    nativeWakeListening = false;
+                    destroyCommandRecognizer();
+                    startWakeListening(250);
+                }
+
+                @Override
+                public void onPartialResults(Bundle partialResults) {
+                    if (nativeWakeListening) {
+                        handleNativeWakeResults(partialResults, false);
+                    }
+                }
+
+                @Override public void onEvent(int eventType, Bundle params) { }
+            });
+            nativeWakeListening = true;
+            speechRecognizer.startListening(wakeRecognizerIntent);
+            broadcastStatus("Starting high-accuracy wake listener");
+            updateNotification("Starting wake listener");
+        } catch (RuntimeException error) {
+            nativeWakeListening = false;
+            destroyCommandRecognizer();
+            nativeWakeFailures++;
+            startWakeListening(900);
+        }
+    }
+
+    private boolean handleNativeWakeResults(Bundle results, boolean finalResult) {
+        ArrayList<String> choices = results == null
+                ? null
+                : results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
+        if (choices == null || choices.isEmpty()) {
+            return false;
+        }
+        String preview = "";
+        for (String choice : choices) {
+            String normalized = normalizeForEcho(choice);
+            if (normalized.isEmpty()) {
+                continue;
+            }
+            if (preview.isEmpty()) {
+                preview = normalized;
+            }
+            String command = commandAfterNativeWake(normalized);
+            if (command != null) {
+                nativeWakeFailures = 0;
+                lastWakePreview = "";
+                nativeWakeListening = false;
+                stopWakeListening();
+                respondToWake(command);
+                return true;
+            }
+        }
+        nativeWakeFailures = 0;
+        if (!preview.isEmpty()) {
+            String visible = preview.length() > 48 ? preview.substring(0, 48) + "…" : preview;
+            lastWakePreview = visible;
+            broadcastStatus("Wake heard: " + visible);
+            if (finalResult) {
+                updateNotification("Heard “" + visible + "” — waiting for Sage");
+            }
+        }
+        return false;
+    }
+
+    private boolean isNativeWakeFailure(int error) {
+        return error == SpeechRecognizer.ERROR_AUDIO
+                || error == SpeechRecognizer.ERROR_CLIENT
+                || error == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS
+                || error == SpeechRecognizer.ERROR_NETWORK
+                || error == SpeechRecognizer.ERROR_NETWORK_TIMEOUT
+                || error == SpeechRecognizer.ERROR_RECOGNIZER_BUSY
+                || error == SpeechRecognizer.ERROR_SERVER;
+    }
