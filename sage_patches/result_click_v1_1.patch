+    private static List<AccessibilityNodeInfo> findResultCandidates(
+            AccessibilityNodeInfo root,
+            int screenHeight
+    ) {
+        List<AccessibilityNodeInfo> candidates = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+        Deque<AccessibilityNodeInfo> queue = new ArrayDeque<>();
+        queue.add(root);
+        int minimumY = Math.max(1, (int) (screenHeight * 0.18f));
+
+        while (!queue.isEmpty()) {
+            AccessibilityNodeInfo node = queue.removeFirst();
+            if (node.isVisibleToUser()) {
+                CharSequence rawText = node.getText();
+                if (rawText == null || rawText.length() == 0) {
+                    rawText = node.getContentDescription();
+                }
+                String text = rawText == null ? "" : rawText.toString().trim();
+                Rect bounds = new Rect();
+                node.getBoundsInScreen(bounds);
+                AccessibilityNodeInfo clickable = nearestClickable(node);
+                if (clickable != null
+                        && !bounds.isEmpty()
+                        && bounds.centerY() >= minimumY
+                        && looksLikeResultText(text)) {
+                    Rect clickBounds = new Rect();
+                    clickable.getBoundsInScreen(clickBounds);
+                    String key = clickBounds.flattenToString() + "|" + text.toLowerCase(Locale.US);
+                    if (seen.add(key)) {
+                        candidates.add(clickable);
+                    }
+                }
+            }
+            for (int i = 0; i < node.getChildCount(); i++) {
+                AccessibilityNodeInfo child = node.getChild(i);
+                if (child != null) {
+                    queue.addLast(child);
+                }
+            }
+        }
+
+        candidates.sort(Comparator.comparingInt(node -> {
+            Rect bounds = new Rect();
+            node.getBoundsInScreen(bounds);
+            return bounds.top;
+        }));
+        return candidates;
+    }
+
+    private static AccessibilityNodeInfo nearestClickable(AccessibilityNodeInfo node) {
+        AccessibilityNodeInfo current = node;
+        for (int depth = 0; current != null && depth < 6; depth++) {
+            if (current.isClickable()) {
+                return current;
+            }
+            current = current.getParent();
+        }
+        return null;
+    }
+
+    private static boolean looksLikeResultText(String text) {
+        if (text == null) {
+            return false;
+        }
+        String value = text.trim().toLowerCase(Locale.US);
+        if (value.length() < 5 || value.length() > 180) {
+            return false;
+        }
+        String[] ignored = {
+                "search", "all", "images", "videos", "news", "maps", "shopping",
+                "books", "more", "tools", "filters", "sign in", "home", "explore",
+                "shorts", "subscriptions", "library", "you", "youtube", "google"
+        };
+        for (String item : ignored) {
+            if (value.equals(item)) {
+                return false;
+            }
+        }
+        return true;
+    }
