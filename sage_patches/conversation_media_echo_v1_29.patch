--- a/app/src/main/java/com/pineapple/sage/SageMediaCaptureLifecycle.java
+++ b/app/src/main/java/com/pineapple/sage/SageMediaCaptureLifecycle.java
@@ -0,0 +1,37 @@
+package com.pineapple.sage;
+
+/** Android-free bookkeeping for reversible media changes during an authorized capture. */
+final class SageMediaCaptureLifecycle {
+    static final class Restoration {
+        final boolean restorePlayback;
+        final boolean abandonFocus;
+        final String reason;
+
+        Restoration(boolean restorePlayback, boolean abandonFocus, String reason) {
+            this.restorePlayback = restorePlayback;
+            this.abandonFocus = abandonFocus;
+            this.reason = reason == null ? "" : reason;
+        }
+    }
+
+    private boolean captureActive;
+    private boolean playbackChanged;
+    private boolean focusChanged;
+
+    synchronized void begin() {
+        captureActive = true;
+        playbackChanged = false;
+        focusChanged = false;
+    }
+
+    synchronized void playbackPaused() { if (captureActive) playbackChanged = true; }
+    synchronized void focusDucked() { if (captureActive) focusChanged = true; }
+
+    synchronized Restoration finish(String reason) {
+        Restoration result = new Restoration(playbackChanged, focusChanged, reason);
+        captureActive = false;
+        playbackChanged = false;
+        focusChanged = false;
+        return result;
+    }
+}
