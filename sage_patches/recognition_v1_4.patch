+    private String chooseBestCandidate(ArrayList<String> choices) {
+        if (choices == null || choices.isEmpty()) {
+            return "";
+        }
+        for (String choice : choices) {
+            if (looksLikeRedQueenCommand(choice)) {
+                return "red queen mode";
+            }
+        }
+        for (String choice : choices) {
+            String normalized = normalizeForEcho(choice);
+            if (normalized.startsWith("sage ") || containsCommandWord(normalized)) {
+                return choice.trim();
+            }
+        }
+        String first = choices.get(0);
+        return first == null ? "" : first.trim();
+    }
+
+    private boolean looksLikeRedQueenCommand(String value) {
+        String heard = normalizeForEcho(value);
+        if (heard.isEmpty()) {
+            return false;
+        }
+        if (heard.startsWith("sage ")) {
+            heard = heard.substring(5).trim();
+        }
+        if (heard.contains("red queen")) {
+            return true;
+        }
+        String[] commonMishearings = {
+                "red green mode", "read queen mode", "red cream mode", "red clean mode",
+                "bread queen mode", "wreck queen mode", "red queen mood", "red queen moat",
+                "thanks", "thank", "things"
+        };
+        for (String phrase : commonMishearings) {
+            if (heard.equals(phrase)) {
+                return true;
+            }
+        }
+        return editDistance(heard, "red queen mode") <= 4;
+    }
+
+    private boolean containsCommandWord(String value) {
+        String[] words = {
+                "open", "search", "youtube", "home", "back", "recent", "scroll", "tap",
+                "click", "type", "write", "volume", "pause", "play", "next", "previous",
+                "notification", "remember", "red", "queen", "sleep", "help"
+        };
+        for (String word : words) {
+            if (value.equals(word) || value.startsWith(word + " ") || value.contains(" " + word + " ")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private int editDistance(String left, String right) {
+        int[] previous = new int[right.length() + 1];
+        int[] current = new int[right.length() + 1];
+        for (int j = 0; j <= right.length(); j++) {
+            previous[j] = j;
+        }
+        for (int i = 1; i <= left.length(); i++) {
+            current[0] = i;
+            for (int j = 1; j <= right.length(); j++) {
+                int cost = left.charAt(i - 1) == right.charAt(j - 1) ? 0 : 1;
+                current[j] = Math.min(
+                        Math.min(current[j - 1] + 1, previous[j] + 1),
+                        previous[j - 1] + cost
+                );
+            }
+            int[] swap = previous;
+            previous = current;
+            current = swap;
+        }
+        return previous[right.length()];
+    }
