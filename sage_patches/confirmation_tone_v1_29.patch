+package com.pineapple.sage;
+
+import java.util.Locale;
+
+/** One Sage identity with an owner-selected presentation preference. */
+final class SageTonePolicy {
+    enum Tone { CLEAN, CASUAL, UNFILTERED }
+    enum MessageClass { CONVERSATION, SECURITY, DIAGNOSTIC, VERIFICATION, EMERGENCY, EXACT_ERROR }
+    static Tone command(Tone current,String spoken){String v=normalize(spoken);if(v.contains("stop cussing"))return Tone.CLEAN;if(v.contains("you can cuss around me"))return Tone.UNFILTERED;if(v.contains("turn the sass up"))return current==Tone.CLEAN?Tone.CASUAL:Tone.UNFILTERED;if(v.contains("tone it down"))return current==Tone.UNFILTERED?Tone.CASUAL:Tone.CLEAN;return current;}
+    static boolean isToneCommand(String spoken){String v=normalize(spoken);return v.contains("you can cuss around me")||v.contains("turn the sass up")||v.contains("tone it down")||v.contains("stop cussing")||v.contains("what is your language setting");}
+    static String response(Tone tone){return "Language setting: "+tone.name()+".";}
+    static String format(Tone tone,String text,MessageClass kind){if(kind!=MessageClass.CONVERSATION||tone==Tone.CLEAN)return text;if(tone==Tone.CASUAL)return text+" I’ve got you.";return text+" Hell yeah—I’ve got you.";}
+    static String brainInstruction(Tone tone){if(tone==Tone.CASUAL)return "Tone: CASUAL. Stay Sage; occasional natural mild profanity is allowed.";if(tone==Tone.UNFILTERED)return "Tone: UNFILTERED. Stay Sage; you may mirror the owner's language and use playful cheeky profanity.";return "Tone: CLEAN. Use warm language without profanity.";}
+    private static String normalize(String v){return v==null?"":v.toLowerCase(Locale.US).replaceAll("[^a-z0-9 ]+"," ").replaceAll("\\s+"," ").trim();}
+}
