+    private void askSpeechConfirmation(SageConversationStateMachine.Decision decision,
+                                       ArrayList<String> alternatives, float confidence) {
+        SageIntentCoordinator.Plan plan = SageIntentCoordinator.understand(this,
+                decision.selectedCandidate, brainManager != null && brainManager.canAnswer(),
+                SageForgeStore.isPaired(this));
+        SageConfirmationLearning.Pending pending = confirmationLearning.begin(
+                decision.turnId, decision.callbackGeneration, decision.selectedCandidate,
+                decision.normalized, alternatives.toString(), confidence, plan.intent,
+                plan.entities, SageActionContextStore.contextSummary(this), plan.riskDecision,
+                System.currentTimeMillis());
+        SageConfirmationStore.savePending(this, pending);
+        String question = SageConfirmationLearning.question(pending.raw);
+        SageDiagnostics.appendEvent(this, "CONFIRMATION",
+                "state=pending turn=" + pending.turnId + " recognizer_generation="
+                        + pending.generation + " candidate=" + pending.raw + " alternatives="
+                        + pending.alternatives + " confidence=" + pending.confidence
+                        + " rejection_reason=low_confidence dispatch_count=0 expires="
+                        + pending.expiresAt);
+        openConversationWindow();
+        listenForCommandAfterSpeech = true;
+        broadcastLine("Sage", question);
+        speak(question);
+    }
+
+    private boolean handleConfirmationAnswer(String transcript, long turnId, long generation) {
+        SageConfirmationLearning.Pending pending = confirmationLearning.pending(System.currentTimeMillis());
+        if (pending == null) {
+            SageConfirmationStore.clearPending(this);
+            return false;
+        }
+        SageConfirmationLearning.Answer answer = confirmationLearning.answer(
+                transcript, turnId, generation, System.currentTimeMillis());
+        SageDiagnostics.appendEvent(this, "CONFIRMATION",
+                "state=answered answer=" + transcript + " candidate=" + pending.raw
+                        + " dispatch_count=" + (answer.execute ? 1 : 0)
+                        + " rejection_reason=" + answer.rejection);
+        if ("not_confirmation_answer".equals(answer.rejection)) return false;
+        SageConfirmationStore.clearPending(this);
+        if (answer.retry) {
+            rejectedForCorrection = pending.raw;
+            rejectedContext = pending.context;
+            openConversationWindow();
+            listenForCommandAfterSpeech = true;
+            broadcastLine("Sage", answer.response);
+            speak(answer.response);
+            return true;
+        }
+        if (answer.execute) {
+            if (answer.save) {
+                SageConfirmationLearning.Correction correction = confirmationLearning.learn(
+                        pending.raw, pending.raw, pending.intent, pending.context,
+                        pending.risk, pending.confidence, System.currentTimeMillis());
+                SageConfirmationStore.saveCorrection(this, correction);
+                SageDiagnostics.appendEvent(this, "CONFIRMATION",
+                        "learned_mapping=" + pending.raw + " -> " + pending.raw
+                                + " source=owner_confirmed save_count=1");
+            }
+            handleCommand(answer.candidate);
+        } else {
+            closeConversationWindow();
+            startWakeListening(300);
+        }
+        return true;
+    }
