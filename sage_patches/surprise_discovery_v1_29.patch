+package com.pineapple.sage;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Random;
+import java.util.Set;
+
+/** Android-free, seeded, Standard-safe surprise discovery policy. */
+final class SageSurprisePolicy {
+    enum Command { SURPRISE, YOUTUBE, WEIRD, BORED, RABBIT_HOLE, ANOTHER, STOP, NONE }
+    enum Route { DIRECT_DEEP_LINK, MEDIA_SESSION, PENDING_SEMANTIC_SELECTION,
+        ACCESSIBILITY_FALLBACK, CLARIFICATION, CANCELLED, UNSUPPORTED }
+    static final class Candidate {
+        final String title, uri, provider, topic, source;
+        final boolean visible, enabled, stale, advertising, navigation, related, standardSafe;
+        Candidate(String title,String uri,String provider,String topic,String source,
+                boolean visible,boolean enabled,boolean stale,boolean advertising,
+                boolean navigation,boolean related,boolean standardSafe) {
+            this.title=clean(title);this.uri=clean(uri);this.provider=clean(provider);
+            this.topic=clean(topic);this.source=clean(source);this.visible=visible;
+            this.enabled=enabled;this.stale=stale;this.advertising=advertising;
+            this.navigation=navigation;this.related=related;this.standardSafe=standardSafe;
+        }
+        String identity(){return normalize(provider)+"|"+normalize(title)+"|"+normalize(uri);}
+    }
+    static Command parse(String raw){String v=normalize(raw).replaceFirst("^(hey )?sage ","");
+        if(v.equals("stop"))return Command.STOP;if(v.equals("another")||v.equals("another one"))return Command.ANOTHER;
+        if(v.contains("surprise me on youtube"))return Command.YOUTUBE;if(v.contains("rabbit hole"))return Command.RABBIT_HOLE;
+        if(v.contains("something weird")||v.equals("weird"))return Command.WEIRD;
+        if(v.contains("cure my boredom")||v.contains("cure boredom")||v.equals("i am bored")||v.equals("i m bored")||v.equals("im bored"))return Command.BORED;
+        if(v.equals("surprise me"))return Command.SURPRISE;return Command.NONE;}
+    static Candidate choose(List<Candidate> candidates,Set<String> recent,long seed,String provider,String topic){
+        List<Candidate> eligible=new ArrayList<>();String wantedProvider=normalize(provider),wantedTopic=normalize(topic);
+        for(Candidate c:candidates){if(!eligible(c))continue;if(!wantedProvider.isEmpty()&&!normalize(c.provider).equals(wantedProvider))continue;
+            if(!wantedTopic.isEmpty()&&!normalize(c.topic).contains(wantedTopic))continue;if(recent!=null&&recent.contains(c.identity()))continue;eligible.add(c);}
+        if(eligible.isEmpty()&&recent!=null&&!recent.isEmpty()){for(Candidate c:candidates)if(eligible(c)&&(wantedProvider.isEmpty()||normalize(c.provider).equals(wantedProvider)))eligible.add(c);}
+        if(eligible.isEmpty())return null;Collections.sort(eligible,(a,b)->a.identity().compareTo(b.identity()));
+        return eligible.get(new Random(seed).nextInt(eligible.size()));}
+    static boolean eligible(Candidate c){return c!=null&&c.standardSafe&&c.visible&&c.enabled&&!c.stale&&!c.advertising&&!c.navigation&&c.related&&!c.title.isEmpty()&&!redQueenText(c.source)&&!redQueenText(c.title);}
+    static boolean revalidate(Candidate saved,Candidate current){return saved!=null&&current!=null&&saved.identity().equals(current.identity())&&eligible(current);}
+    static Set<String> recent(String encoded){Set<String> out=new HashSet<>();if(encoded!=null)for(String value:encoded.split("\\n"))if(!value.trim().isEmpty())out.add(value.trim());return out;}
+    static String encodeRecent(Set<String> values){List<String> sorted=new ArrayList<>(values);Collections.sort(sorted);StringBuilder out=new StringBuilder();for(String value:sorted){if(out.length()>0)out.append('\n');out.append(value);}return out.toString();}
+    static boolean redQueenText(String value){String v=normalize(value);return v.contains("red queen")||v.contains("red_queen")||v.contains("private vault")||v.contains("investigation");}
+    private static String clean(String value){return value==null?"":value.trim();}
+    private static String normalize(String value){return clean(value).toLowerCase(Locale.US).replaceAll("[^a-z0-9]+"," ").replaceAll("\\s+"," ").trim();}
+}
