diff --git a/app/src/main/java/com/pineapple/sage/SageTranslationManager.java b/app/src/main/java/com/pineapple/sage/SageTranslationManager.java
new file mode 100644
index 0000000..f5cefe5
--- /dev/null
+++ b/app/src/main/java/com/pineapple/sage/SageTranslationManager.java
@@ -0,0 +1,380 @@
+package com.pineapple.sage;
+
+import com.google.mlkit.common.model.DownloadConditions;
+import com.google.mlkit.nl.languageid.LanguageIdentification;
+import com.google.mlkit.nl.languageid.LanguageIdentifier;
+import com.google.mlkit.nl.translate.TranslateLanguage;
+import com.google.mlkit.nl.translate.Translation;
+import com.google.mlkit.nl.translate.Translator;
+import com.google.mlkit.nl.translate.TranslatorOptions;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class SageTranslationManager {
+    public interface Callback {
+        void onStatus(String status);
+        void onSuccess(String translatedText, String targetSpeechTag, String targetLanguageName);
+        void onFailure(String message);
+    }
+
+    public static final class Request {
+        public final String text;
+        public final LanguageSpec source;
+        public final LanguageSpec target;
+        public final String errorMessage;
+
+        private Request(String text, LanguageSpec source, LanguageSpec target, String errorMessage) {
+            this.text = text;
+            this.source = source;
+            this.target = target;
+            this.errorMessage = errorMessage;
+        }
+
+        public boolean isValid() {
+            return errorMessage.isEmpty() && !text.isEmpty() && target != null;
+        }
+    }
+
+    public static final class LanguageSpec {
+        public final String translationTag;
+        public final String speechTag;
+        public final String displayName;
+
+        private LanguageSpec(String translationTag, String speechTag, String displayName) {
+            this.translationTag = translationTag;
+            this.speechTag = speechTag;
+            this.displayName = displayName;
+        }
+    }
+
+    private static final Pattern EXPLICIT_SOURCE = Pattern.compile(
+            "(?i)^translate\\s+(.+?)\\s+from\\s+(.+?)\\s+to\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Pattern TRANSLATE_TO = Pattern.compile(
+            "(?i)^translate\\s+(.+?)\\s+to\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Pattern SAY_IN = Pattern.compile(
+            "(?i)^say\\s+(.+?)\\s+in\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Pattern HOW_TO_SAY = Pattern.compile(
+            "(?i)^(?:tell\\s+me\\s+)?how\\s+do\\s+(?:i|you)\\s+say\\s+(.+?)\\s+in\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Pattern WHAT_DOES_MEAN = Pattern.compile(
+            "(?i)^what\\s+does\\s+(.+?)\\s+mean\\s+in\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Pattern WHAT_IS_IN = Pattern.compile(
+            "(?i)^what\\s+is\\s+(.+?)\\s+in\\s+(.+?)\\s*[?.!]*$"
+    );
+    private static final Map<String, LanguageSpec> LANGUAGES = buildLanguages();
+    private LanguageIdentifier activeIdentifier;
+    private Translator activeTranslator;
+
+    public Request parse(String command) {
+        String value = stripConversationPrefix(cleanText(command));
+        if (value.isEmpty()) {
+            return null;
+        }
+
+        Matcher explicit = EXPLICIT_SOURCE.matcher(value);
+        if (explicit.matches()) {
+            LanguageSpec source = resolveLanguage(explicit.group(2));
+            LanguageSpec target = resolveLanguage(explicit.group(3));
+            if (source == null) {
+                return error("I do not recognize the source language " + cleanText(explicit.group(2)) + ".");
+            }
+            if (target == null) {
+                return unsupportedTarget(explicit.group(3));
+            }
+            return request(explicit.group(1), source, target);
+        }
+
+        Request parsed = parseTwoPart(value, TRANSLATE_TO, true);
+        if (parsed != null) {
+            return parsed;
+        }
+        parsed = parseTwoPart(value, HOW_TO_SAY, true);
+        if (parsed != null) {
+            return parsed;
+        }
+        parsed = parseTwoPart(value, SAY_IN, true);
+        if (parsed != null) {
+            return parsed;
+        }
+        parsed = parseTwoPart(value, WHAT_DOES_MEAN, false);
+        if (parsed != null) {
+            return parsed;
+        }
+        parsed = parseTwoPart(value, WHAT_IS_IN, false);
+        if (parsed != null) {
+            return parsed;
+        }
+
+        String lower = value.toLowerCase(Locale.US);
+        if (lower.equals("translate") || lower.startsWith("translate ")
+                || lower.startsWith("how do i say ")
+                || lower.startsWith("how do you say ")) {
+            return error("Try saying, translate good morning to Spanish.");
+        }
+        return null;
+    }
+
+    public void translate(Request request, Callback callback) {
+        close();
+        if (request == null || !request.isValid()) {
+            callback.onFailure(request == null
+                    ? "I could not understand that translation request."
+                    : request.errorMessage);
+            return;
+        }
+        if (request.source != null) {
+            translateFrom(request, request.source.translationTag, callback);
+            return;
+        }
+
+        callback.onStatus("Identifying the language");
+        LanguageIdentifier identifier = LanguageIdentification.getClient();
+        activeIdentifier = identifier;
+        identifier.identifyLanguage(request.text)
+                .addOnSuccessListener(languageTag -> {
+                    identifier.close();
+                    if (activeIdentifier == identifier) {
+                        activeIdentifier = null;
+                    }
+                    String sourceTag = languageTag == null
+                            ? null
+                            : TranslateLanguage.fromLanguageTag(languageTag);
+                    if (sourceTag == null || "und".equals(languageTag)) {
+                        if (request.target.translationTag.equals(TranslateLanguage.ENGLISH)) {
+                            callback.onFailure("I could not identify that language. Try saying, translate the phrase from Spanish to English.");
+                            return;
+                        }
+                        sourceTag = TranslateLanguage.ENGLISH;
+                    }
+                    translateFrom(request, sourceTag, callback);
+                })
+                .addOnFailureListener(error -> {
+                    identifier.close();
+                    if (activeIdentifier == identifier) {
+                        activeIdentifier = null;
+                    }
+                    if (request.target.translationTag.equals(TranslateLanguage.ENGLISH)) {
+                        callback.onFailure("I could not identify the original language. Try naming it with, from Spanish to English.");
+                    } else {
+                        translateFrom(request, TranslateLanguage.ENGLISH, callback);
+                    }
+                });
+    }
+
+    private void translateFrom(Request request, String sourceTag, Callback callback) {
+        if (sourceTag.equals(request.target.translationTag)) {
+            callback.onSuccess(request.text, request.target.speechTag, request.target.displayName);
+            return;
+        }
+
+        TranslatorOptions options = new TranslatorOptions.Builder()
+                .setSourceLanguage(sourceTag)
+                .setTargetLanguage(request.target.translationTag)
+                .build();
+        Translator translator = Translation.getClient(options);
+        activeTranslator = translator;
+        DownloadConditions conditions = new DownloadConditions.Builder()
+                .requireWifi()
+                .build();
+
+        callback.onStatus("Preparing " + request.target.displayName + " language pack");
+        translator.downloadModelIfNeeded(conditions)
+                .addOnSuccessListener(unused -> translator.translate(request.text)
+                        .addOnSuccessListener(translatedText -> {
+                            translator.close();
+                            if (activeTranslator == translator) {
+                                activeTranslator = null;
+                            }
+                            callback.onSuccess(
+                                    translatedText,
+                                    request.target.speechTag,
+                                    request.target.displayName
+                            );
+                        })
+                        .addOnFailureListener(error -> {
+                            translator.close();
+                            if (activeTranslator == translator) {
+                                activeTranslator = null;
+                            }
+                            callback.onFailure("I could not translate that phrase.");
+                        }))
+                .addOnFailureListener(error -> {
+                    translator.close();
+                    if (activeTranslator == translator) {
+                        activeTranslator = null;
+                    }
+                    callback.onFailure(
+                            "I need Wi-Fi to download the "
+                                    + request.target.displayName
+                                    + " language pack the first time. After that it will work offline."
+                    );
+                });
+    }
+
+    public void close() {
+        if (activeIdentifier != null) {
+            activeIdentifier.close();
+            activeIdentifier = null;
+        }
+        if (activeTranslator != null) {
+            activeTranslator.close();
+            activeTranslator = null;
+        }
+    }
+
+    private Request parseTwoPart(String value, Pattern pattern, boolean reportUnknownTarget) {
+        Matcher matcher = pattern.matcher(value);
+        if (!matcher.matches()) {
+            return null;
+        }
+        LanguageSpec target = resolveLanguage(matcher.group(2));
+        if (target == null) {
+            return reportUnknownTarget ? unsupportedTarget(matcher.group(2)) : null;
+        }
+        return request(matcher.group(1), null, target);
+    }
+
+    private Request request(String text, LanguageSpec source, LanguageSpec target) {
+        String cleaned = cleanPhrase(text);
+        if (cleaned.isEmpty()) {
+            return error("Tell me what you want translated.");
+        }
+        return new Request(cleaned, source, target, "");
+    }
+
+    private Request error(String message) {
+        return new Request("", null, null, message);
+    }
+
+    private Request unsupportedTarget(String language) {
+        return error(
+                "I do not recognize the language "
+                        + cleanText(language)
+                        + ". Try Spanish, French, German, Japanese, Chinese, or another supported language."
+        );
+    }
+
+    private static LanguageSpec resolveLanguage(String spokenName) {
+        return LANGUAGES.get(normalizeLanguageName(spokenName));
+    }
+
+    private static Map<String, LanguageSpec> buildLanguages() {
+        Map<String, LanguageSpec> languages = new HashMap<>();
+        add(languages, "af", "af", "Afrikaans");
+        add(languages, "ar", "ar", "Arabic");
+        add(languages, "be", "be", "Belarusian");
+        add(languages, "bg", "bg", "Bulgarian");
+        add(languages, "bn", "bn", "Bengali");
+        add(languages, "ca", "ca", "Catalan");
+        add(languages, "cs", "cs", "Czech");
+        add(languages, "cy", "cy", "Welsh");
+        add(languages, "da", "da", "Danish");
+        add(languages, "de", "de", "German", "Deutsch");
+        add(languages, "el", "el", "Greek");
+        add(languages, "en", "en-US", "English", "American English", "US English");
+        add(languages, "eo", "eo", "Esperanto");
+        add(languages, "es", "es-ES", "Spanish", "Español", "Espanol");
+        add(languages, "et", "et", "Estonian");
+        add(languages, "fa", "fa", "Persian", "Farsi");
+        add(languages, "fi", "fi", "Finnish");
+        add(languages, "fr", "fr-FR", "French", "Français", "Francais");
+        add(languages, "ga", "ga", "Irish", "Irish Gaelic");
+        add(languages, "gl", "gl", "Galician");
+        add(languages, "gu", "gu", "Gujarati");
+        add(languages, "he", "he", "Hebrew");
+        add(languages, "hi", "hi-IN", "Hindi");
+        add(languages, "hr", "hr", "Croatian");
+        add(languages, "ht", "ht", "Haitian", "Haitian Creole");
+        add(languages, "hu", "hu", "Hungarian");
+        add(languages, "id", "id", "Indonesian", "Bahasa Indonesia");
+        add(languages, "is", "is", "Icelandic");
