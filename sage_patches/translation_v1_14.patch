+    private static void add(
+            Map<String, LanguageSpec> languages,
+            String translationTag,
+            String speechTag,
+            String displayName,
+            String... aliases
+    ) {
+        LanguageSpec spec = new LanguageSpec(translationTag, speechTag, displayName);
+        languages.put(normalizeLanguageName(displayName), spec);
+        languages.put(normalizeLanguageName(translationTag), spec);
+        for (String alias : aliases) {
+            languages.put(normalizeLanguageName(alias), spec);
+        }
+    }
+
+    private static String normalizeLanguageName(String value) {
+        return cleanText(value)
+                .toLowerCase(Locale.US)
+                .replace(" language", "")
+                .replaceAll("[^a-z0-9 ]", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+
+    private static String cleanPhrase(String value) {
+        String text = cleanText(value);
+        text = text.replaceFirst("^[\"'“”‘’]+", "");
+        text = text.replaceFirst("[\"'“”‘’]+$", "");
+        return cleanText(text);
+    }
+
+    private static String stripConversationPrefix(String value) {
+        String result = cleanText(value);
+        String previous;
+        do {
+            previous = result;
+            result = result.replaceFirst("(?i)^(hey\\s+)?sage[\\s,.:;-]+", "");
+            result = result.replaceFirst("(?i)^(can|could|would|will)\\s+you[\\s,.:;-]+", "");
+            result = result.replaceFirst("(?i)^please[\\s,.:;-]+", "");
+            result = cleanText(result);
+        } while (!result.equals(previous));
+        return result;
+    }
+
+    private static String cleanText(String value) {
+        return value == null ? "" : value.trim().replaceAll("\\s+", " ");
+    }
