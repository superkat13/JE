+    private void openConversationWindow() {
+        conversationActive = true;
+        lastWakePreview = "";
+        extendConversationWindow();
+    }
+
+    private void extendConversationWindow() {
+        if (!conversationActive || stopRequested) {
+            return;
+        }
+        conversationExpiresAtMs = System.currentTimeMillis() + CONVERSATION_WINDOW_MS;
+        handler.removeCallbacks(conversationExpiryRunnable);
+        handler.postDelayed(conversationExpiryRunnable, CONVERSATION_WINDOW_MS + 100L);
+    }
+
+    private boolean isConversationOpen() {
+        if (!conversationActive) {
+            return false;
+        }
+        if (System.currentTimeMillis() < conversationExpiresAtMs) {
+            return true;
+        }
+        conversationActive = false;
+        handler.removeCallbacks(conversationExpiryRunnable);
+        return false;
+    }
+
+    private void closeConversationWindow() {
+        conversationActive = false;
+        conversationExpiresAtMs = 0L;
+        listenForCommandAfterSpeech = false;
+        handler.removeCallbacks(conversationExpiryRunnable);
+    }
+
+    private void expireConversationIfNeeded() {
+        if (!conversationActive || stopRequested) {
+            return;
+        }
+        long remaining = conversationExpiresAtMs - System.currentTimeMillis();
+        if (remaining > 0L) {
+            handler.postDelayed(conversationExpiryRunnable, remaining + 100L);
+            return;
+        }
+        conversationActive = false;
+        conversationExpiresAtMs = 0L;
+        commandStartPending = false;
+        if (speaking) {
+            return;
+        }
+        destroyCommandRecognizer();
+        broadcastStatus("Conversation closed — say Sage");
+        updateNotification("Say Sage");
+        startWakeListening(300);
+    }
+
+    private void resumeConversationOrWake(long delayMs) {
+        if (isConversationOpen()) {
+            broadcastStatus("Conversation open — keep talking");
+            updateNotification("Conversation open — keep talking");
+            startCommandRecognition(delayMs);
+        } else {
+            startWakeListening(delayMs);
+        }
+    }
+
+    private boolean isConversationCloseCommand(String command) {
+        String normalized = normalizeForEcho(command);
+        return normalized.equals("that s all")
+                || normalized.equals("that is all")
+                || normalized.equals("never mind")
+                || normalized.equals("end conversation")
+                || normalized.equals("close conversation")
+                || normalized.equals("thanks sage")
+                || normalized.equals("thank you sage");
+    }
