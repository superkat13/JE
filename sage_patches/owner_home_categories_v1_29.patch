+    private LinearLayout categoryPanel(String title) {
+        LinearLayout panel = new LinearLayout(this);
+        panel.setOrientation(LinearLayout.VERTICAL);
+        panel.setPadding(dp(4), dp(8), dp(4), dp(18));
+        panel.setVisibility(View.GONE);
+        panel.setContentDescription(title);
+        TextView heading = new TextView(this);
+        heading.setText(title);
+        heading.setTextSize(25);
+        heading.setTextColor(Color.rgb(31, 41, 55));
+        heading.setPadding(dp(4), dp(14), dp(4), dp(4));
+        panel.addView(heading, matchWrap());
+        categoryPanels.add(panel);
+        return panel;
+    }
+
+    private void addCategoryNavigation(LinearLayout root, LinearLayout voicePanel,
+                                       LinearLayout brainMemoryPanel, LinearLayout createPanel,
+                                       LinearLayout toolsPanel, LinearLayout diagnosticsPanel) {
+        TextView heading = new TextView(this);
+        heading.setText("Sage spaces");
+        heading.setTextSize(23);
+        heading.setTextColor(Color.rgb(31, 41, 55));
+        heading.setPadding(dp(4), dp(18), dp(4), dp(2));
+        root.addView(heading, spaced());
+
+        TextView help = new TextView(this);
+        help.setText("Talk and typed commands stay ready above. Open one working area below; unfinished tools stay hidden.");
+        help.setTextSize(14);
+        help.setTextColor(Color.DKGRAY);
+        help.setPadding(dp(8), dp(2), dp(8), dp(8));
+        root.addView(help, matchWrap());
+
+        LinearLayout first = surpriseRow();
+        addCategoryButton(first, "Voice & Wake", voicePanel);
+        addCategoryButton(first, "Brain & Memory", brainMemoryPanel);
+        root.addView(first, spacedSmall());
+
+        LinearLayout second = surpriseRow();
+        addCategoryButton(second, "Create & Discover", createPanel);
+        addCategoryButton(second, "Tools & Settings", toolsPanel);
+        root.addView(second, spacedSmall());
+
+        LinearLayout third = surpriseRow();
+        addCategoryButton(third, "Diagnostics & Repair", diagnosticsPanel);
+        root.addView(third, spacedSmall());
+
+        root.addView(voicePanel, matchWrap());
+        root.addView(brainMemoryPanel, matchWrap());
+        root.addView(createPanel, matchWrap());
+        root.addView(toolsPanel, matchWrap());
+        root.addView(diagnosticsPanel, matchWrap());
