+    private void addInstalledAdobeActions(LinearLayout panel) {
+        ArrayList<SageTrustedAppRegistry.InstalledApp> launchable = new ArrayList<>();
+        for (SageTrustedAppRegistry.InstalledApp app
+                : SageTrustedAppRegistry.installedAdobeApps(this)) {
+            if (app.launch) launchable.add(app);
+        }
+        if (launchable.isEmpty()) return;
+
+        TextView title = new TextView(this);
+        title.setText("Installed Adobe apps");
+        title.setTextSize(18);
+        title.setTextColor(Color.rgb(31, 41, 55));
+        title.setPadding(dp(8), dp(14), dp(8), dp(2));
+        panel.addView(title, matchWrap());
+        for (SageTrustedAppRegistry.InstalledApp app : launchable) {
+            Button button = makeButton("Open " + app.label);
+            button.setContentDescription("Open installed Adobe app " + app.label);
+            button.setOnClickListener(v -> openInstalledAdobeApp(app));
+            panel.addView(button, spacedSmall());
+        }
+    }
+
+    private void openInstalledAdobeApp(SageTrustedAppRegistry.InstalledApp app) {
+        Intent launch = getPackageManager().getLaunchIntentForPackage(app.packageName);
+        if (launch == null) {
+            Toast.makeText(this, app.label + " is installed but cannot be opened.",
+                    Toast.LENGTH_LONG).show();
+            SageDiagnostics.appendEvent(this, "ADOBE LAUNCH",
+                    "verified=false package=" + app.packageName + " reason=no_launch_activity");
+            return;
+        }
+        try {
+            startActivity(launch);
+            SageDiagnostics.appendEvent(this, "ADOBE LAUNCH",
+                    "verified=true package=" + app.packageName);
+        } catch (RuntimeException error) {
+            Toast.makeText(this, "Android could not open " + app.label + ".",
+                    Toast.LENGTH_LONG).show();
+            SageDiagnostics.appendEvent(this, "ADOBE LAUNCH",
+                    "verified=false package=" + app.packageName
+                            + " error=" + error.getClass().getSimpleName());
+        }
+    }
