+    private void toggleCategory(Button selectedButton, LinearLayout selectedPanel) {
+        boolean opening = selectedPanel.getVisibility() != View.VISIBLE;
+        for (LinearLayout panel : categoryPanels) panel.setVisibility(View.GONE);
+        for (Button button : categoryButtons) {
+            button.setText("▶ " + String.valueOf(button.getTag()));
+            button.setContentDescription("Open " + String.valueOf(button.getTag()) + " category");
+        }
+        if (opening) {
+            selectedPanel.setVisibility(View.VISIBLE);
+            selectedButton.setText("▼ " + String.valueOf(selectedButton.getTag()));
+            selectedButton.setContentDescription("Close " + String.valueOf(selectedButton.getTag()) + " category");
