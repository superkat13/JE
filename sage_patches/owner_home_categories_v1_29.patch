     private LinearLayout surpriseRow(){LinearLayout row=new LinearLayout(this);row.setOrientation(LinearLayout.HORIZONTAL);return row;}
     private void addSurpriseButton(LinearLayout row,String label,String command){Button button=makeButton(label);button.setMinHeight(dp(44));button.setContentDescription(label+" surprise discovery");button.setOnClickListener(v->{dispatchTypedCommand(command);button.postDelayed(this::refreshSurpriseSummary,1200L);});row.addView(button,new LinearLayout.LayoutParams(0,ViewGroup.LayoutParams.WRAP_CONTENT,1f));}
     private void refreshSurpriseSummary(){if(surpriseSummary!=null)surpriseSummary.setText(SageSurpriseManager.summary(this));}
