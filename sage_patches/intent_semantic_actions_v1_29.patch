+package com.pineapple.sage;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+
+/** Small local context bridge for safe natural follow-ups and owner app preferences. */
+final class SageActionContextStore {
+    private static final String PREFS = "sage_semantic_context_v1";
+    private static final String SUBJECT = "subject";
+    private static final String CONTENT_URI = "selected_content_uri";
+    private static final String CONTENT_MIME = "selected_content_mime";
+    private static final String VIDEO_EDITOR = "preferred_video_editor";
+
+    private SageActionContextStore() {}
+
+    static void rememberSubject(Context context, String subject) {
+        String value = clean(subject);
+        if (!value.isEmpty()) prefs(context).edit().putString(SUBJECT, value).apply();
+    }
+
+    static String subject(Context context) {
+        String value = prefs(context).getString(SUBJECT, "");
+        if (value == null || value.trim().isEmpty()) {
+            value = context.getSharedPreferences("sage_state", Context.MODE_PRIVATE)
+                    .getString("last_query", "");
+        }
+        return clean(value);
+    }
+
+    static boolean rememberSelectedContent(Context context, Uri uri, String mimeType) {
+        if (uri == null || !"content".equalsIgnoreCase(uri.getScheme())) return false;
+        return prefs(context).edit().putString(CONTENT_URI, uri.toString())
+                .putString(CONTENT_MIME, clean(mimeType)).commit();
+    }
+
+    static Uri selectedContent(Context context) {
+        String value = prefs(context).getString(CONTENT_URI, "");
+        return value == null || value.isEmpty() ? null : Uri.parse(value);
+    }
+
+    static String selectedMime(Context context) {
+        return prefs(context).getString(CONTENT_MIME, "application/octet-stream");
+    }
+
+    static boolean preferAdobeForVideo(Context context) {
+        return prefs(context).edit().putString(VIDEO_EDITOR, "adobe").commit();
+    }
+
+    static String videoEditorPreference(Context context) {
+        return prefs(context).getString(VIDEO_EDITOR, "");
+    }
+
+    static String contextSummary(Context context) {
+        Uri selected = selectedContent(context);
+        String subject = subject(context);
+        if (selected != null) return "selected_file=" + selected;
+        return subject.isEmpty() ? "" : "subject=" + subject;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String clean(String value) { return value == null ? "" : value.trim(); }
+}
