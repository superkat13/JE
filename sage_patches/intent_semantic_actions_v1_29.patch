+package com.pineapple.sage;
+
+import java.util.Locale;
+
+/** Android-free compiled policy for the 1.29 intent-to-result action slice. */
+final class SageIntentActionPolicy {
+    enum Action {
+        OPEN_YOUTUBE, OPEN_DOWNLOADS, OPEN_ADOBE_EXPRESS, EDIT_IN_ADOBE,
+        FIND_RADIO_DIAGRAM, FIND_VIDEO, PLAY, CHOOSE_ITEM, SHOW_TARGETS,
+        CHOOSE_GRID_REGION, REFINE_GRID, SHOW_NUMBERS, STORE_ADOBE_VIDEO_PREFERENCE,
+        CLARIFY_DESTRUCTIVE, NONE
+    }
+
+    static final class Decision {
+        final String request;
+        final String intent;
+        final String entities;
+        final String context;
+        final String rememberedPreference;
+        final String capability;
+        final String riskDecision;
+        final Action action;
+        final int ordinal;
+        final String clarification;
+        final String trace;
+
+        Decision(String request, String intent, String entities, String context,
+                 String preference, String capability, String risk, Action action,
+                 int ordinal, String clarification) {
+            this.request = clean(request);
+            this.intent = clean(intent);
+            this.entities = clean(entities);
+            this.context = clean(context);
+            this.rememberedPreference = clean(preference);
+            this.capability = clean(capability);
+            this.riskDecision = clean(risk);
+            this.action = action == null ? Action.NONE : action;
+            this.ordinal = ordinal;
+            this.clarification = clean(clarification);
+            this.trace = "request → intent → entities → context → remembered preference → "
+                    + "capability selection → permission/risk check → execute → verify → concise result";
+        }
+
+        boolean matched() { return action != Action.NONE; }
+        boolean mayExecute() { return matched() && clarification.isEmpty(); }
+    }
+
+    private SageIntentActionPolicy() {}
+
+    static Decision decide(String request, String rememberedContext, String adobePreference) {
+        String raw = clean(request);
+        String value = normalize(raw);
+        String context = clean(rememberedContext);
+        String preference = clean(adobePreference);
+        if (value.equals("open youtube")) return action(raw, "launch_app", "app=youtube",
+                context, preference, "android.launch", "low; no confirmation",
+                Action.OPEN_YOUTUBE, 0);
+        if (value.equals("open downloads")) return action(raw, "open_documents",
+                "collection=downloads", context, preference, "android.documents",
+                "low; system document UI", Action.OPEN_DOWNLOADS, 0);
+        if (value.equals("open adobe express")) return action(raw, "launch_app",
+                "app=adobe express", context, preference, "trusted.adobe.launch",
+                "low; installed app only", Action.OPEN_ADOBE_EXPRESS, 0);
+        if (value.equals("edit this in adobe")) return action(raw, "edit_file",
+                "file=this app=adobe", context, preference, "trusted.adobe.edit",
+                "medium; owner-selected content URI only", Action.EDIT_IN_ADOBE, 0);
+        if (value.equals("find a wiring diagram for this radio")) return action(raw,
+                "web_search", "subject=this radio format=wiring diagram", context,
+                preference, "android.web_search", "low; public web query",
+                Action.FIND_RADIO_DIAGRAM, 0);
+        if (value.equals("find this video")) return action(raw, "video_search",
+                "subject=this video", context, preference, "android.youtube_search",
+                "low; direct app/deep link", Action.FIND_VIDEO, 0);
+        if (value.equals("tap play") || value.equals("play")) return action(raw,
+                "media_control", "control=play", context, preference,
+                "media.session_then_semantic", "low; no confirmation", Action.PLAY, 0);
+        if (value.equals("choose the second item")) return action(raw, "semantic_select",
+                "role=item ordinal=2", context, preference, "accessibility.semantic",
+                "low; visible enabled target", Action.CHOOSE_ITEM, 2);
+        if (value.equals("show targets")) return action(raw, "target_drawer", "screen=current",
+                context, preference, "accessibility.drawer", "low; display only",
+                Action.SHOW_TARGETS, 0);
+        if (value.equals("top right")) return action(raw, "grid_select", "region=top right",
+                context, preference, "accessibility.grid", "low; revalidated target",
+                Action.CHOOSE_GRID_REGION, 0);
+        if (value.equals("refine")) return action(raw, "grid_refine", "screen=current",
+                context, preference, "accessibility.grid", "low; display only",
+                Action.REFINE_GRID, 0);
+        if (value.equals("show numbers")) return action(raw, "number_fallback",
+                "screen=current explicit=true", context, preference,
+                "accessibility.number_fallback", "low; explicit final fallback",
+                Action.SHOW_NUMBERS, 0);
+        if (value.equals("use adobe whenever i edit videos")) return action(raw,
+                "store_preference", "task=video editing app=adobe", context, preference,
+                "memory.preference", "low; owner preference", Action.STORE_ADOBE_VIDEO_PREFERENCE, 0);
+        if (isAmbiguousDestructive(value)) {
+            return new Decision(raw, "destructive_action", "target=ambiguous", context,
+                    preference, "none", "high; clarification required", Action.CLARIFY_DESTRUCTIVE,
+                    0, "Which exact item should I act on?");
+        }
+        return new Decision(raw, "unmatched", "", context, preference, "legacy",
+                "not evaluated", Action.NONE, 0, "");
+    }
+
+    private static Decision action(String request, String intent, String entities,
+                                   String context, String preference, String capability,
+                                   String risk, Action action, int ordinal) {
+        String clarification = "";
+        if ((action == Action.FIND_RADIO_DIAGRAM || action == Action.FIND_VIDEO)
+                && !context.startsWith("subject=")) {
+            clarification = action == Action.FIND_RADIO_DIAGRAM
+                    ? "Which radio model do you mean?" : "Which video do you mean?";
+        }
+        if (action == Action.EDIT_IN_ADOBE && !context.startsWith("selected_file=")) {
+            clarification = "Which selected file should I edit in Adobe?";
+        }
+        return new Decision(request, intent, entities, context, preference, capability,
+                risk, action, ordinal, clarification);
+    }
+
+    private static boolean isAmbiguousDestructive(String value) {
+        return value.equals("delete it") || value.equals("remove it")
+                || value.equals("delete this") || value.equals("remove this")
+                || value.equals("erase it");
+    }
+
+    static String normalize(String value) {
+        return clean(value).toLowerCase(Locale.US).replaceAll("[^a-z0-9 ]", " ")
+                .replaceAll("\\s+", " ").trim();
+    }
+
+    private static String clean(String value) { return value == null ? "" : value.trim(); }
+}
