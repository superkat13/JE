@@ -0,0 +1,81 @@
+package com.pineapple.sage;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/** Android-free semantic ordering and identity policy shared by executable regressions. */
+final class SageSemanticTargetPolicy {
+    static final class Candidate {
+        final String text, description, resourceId, role;
+        final boolean visible, enabled, clickable, clickableAncestor;
+
+        Candidate(String text, String description, String resourceId, String role,
+                  boolean visible, boolean enabled, boolean clickable,
+                  boolean clickableAncestor) {
+            this.text = clean(text);
+            this.description = clean(description);
+            this.resourceId = clean(resourceId);
+            this.role = clean(role);
+            this.visible = visible;
+            this.enabled = enabled;
+            this.clickable = clickable;
+            this.clickableAncestor = clickableAncestor;
+        }
+    }
+
+    private SageSemanticTargetPolicy() {}
+
+    static boolean safe(Candidate value) {
+        return value != null && value.visible && value.enabled
+                && (value.clickable || value.clickableAncestor);
+    }
+
+    static int score(Candidate value, String query) {
+        if (!safe(value)) return -1;
+        String wanted = normalize(query);
+        if (wanted.isEmpty()) return -1;
+        int score = fieldScore(value.text, wanted, 120, 80)
+                + fieldScore(value.description, wanted, 115, 75)
+                + fieldScore(value.resourceId.replace('_', ' '), wanted, 90, 60)
+                + fieldScore(value.role, wanted, 35, 20);
+        if (value.clickableAncestor) score += 15;
+        return score;
+    }
+
+    static Candidate selectOrdinal(List<Candidate> ordered, String query, int ordinal) {
+        if (ordered == null || ordinal < 1) return null;
+        List<Candidate> matches = new ArrayList<>();
+        for (Candidate value : ordered) if (score(value, query) >= 55) matches.add(value);
+        return ordinal <= matches.size() ? matches.get(ordinal - 1) : null;
+    }
+
+    static boolean revalidate(Candidate saved, Candidate current) {
+        if (!safe(saved) || !safe(current)) return false;
+        String savedText = normalize(saved.text), currentText = normalize(current.text);
+        String savedDescription = normalize(saved.description);
+        String currentDescription = normalize(current.description);
+        if (!savedText.isEmpty() && !currentText.isEmpty() && !savedText.equals(currentText)) {
+            return false;
+        }
+        if (!savedDescription.isEmpty() && !currentDescription.isEmpty()
+                && !savedDescription.equals(currentDescription)) return false;
+        return (!savedText.isEmpty() && savedText.equals(currentText))
+                || (!savedDescription.isEmpty() && savedDescription.equals(currentDescription))
+                || (!saved.resourceId.isEmpty() && saved.resourceId.equals(current.resourceId)
+                    && normalize(saved.role).equals(normalize(current.role)));
+    }
+
+    private static int fieldScore(String field, String wanted, int exact, int contains) {
+        String value = normalize(field);
+        if (value.equals(wanted)) return exact;
+        return !value.isEmpty() && value.contains(wanted) ? contains : 0;
+    }
+
+    private static String normalize(String value) {
+        return clean(value).toLowerCase(Locale.US).replaceAll("[^a-z0-9 ]", " ")
+                .replaceAll("\\s+", " ").trim();
+    }
+
+    private static String clean(String value) { return value == null ? "" : value.trim(); }
