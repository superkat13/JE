+package com.pineapple.sage;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/** Compiled trusted app capabilities; installed packages cannot add authority. */
+final class SageTrustedAppRegistry {
+    static final class InstalledApp {
+        final String packageName;
+        final String label;
+        final boolean launch;
+        final boolean edit;
+
+        InstalledApp(String packageName, String label, boolean launch, boolean edit) {
+            this.packageName = packageName;
+            this.label = label;
+            this.launch = launch;
+            this.edit = edit;
+        }
+    }
+
+    private static final String[] ADOBE_PACKAGES = {
+            "com.adobe.spark.post",       // Adobe Express
+            "com.adobe.spark.video",      // Express video where available
+            "com.adobe.premiererush.videoeditor",
+            "com.adobe.photoshop.express",
+            "com.adobe.reader"
+    };
+
+    private SageTrustedAppRegistry() {}
+
+    static List<InstalledApp> installedAdobeApps(Context context) {
+        if (context == null) return Collections.emptyList();
+        PackageManager packages = context.getPackageManager();
+        List<InstalledApp> found = new ArrayList<>();
+        for (String packageName : ADOBE_PACKAGES) {
+            try {
+                ApplicationInfo info = packages.getApplicationInfo(packageName, 0);
+                String label = String.valueOf(packages.getApplicationLabel(info));
+                boolean launch = packages.getLaunchIntentForPackage(packageName) != null;
+                boolean edit = resolves(packages, buildAdobeEditIntent(
+                        Uri.parse("content://com.pineapple.sage/selected"),
+                        "application/octet-stream", packageName));
+                found.add(new InstalledApp(packageName, label, launch, edit));
+            } catch (PackageManager.NameNotFoundException ignored) { }
+        }
+        return found;
+    }
+
+    static InstalledApp bestAdobeApp(Context context, boolean requireEdit) {
+        InstalledApp fallback = null;
+        for (InstalledApp app : installedAdobeApps(context)) {
+            String label = app.label.toLowerCase(Locale.US);
+            if (fallback == null && (!requireEdit || app.edit)) fallback = app;
+            if (label.contains("express") && app.launch && (!requireEdit || app.edit)) return app;
+        }
+        return fallback;
+    }
+
+    static Intent buildAdobeEditIntent(Uri contentUri, String mimeType, String packageName) {
+        if (contentUri == null || !"content".equalsIgnoreCase(contentUri.getScheme())) return null;
+        Intent edit = new Intent(Intent.ACTION_EDIT)
+                .setDataAndType(contentUri, cleanMime(mimeType))
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                        | Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        if (packageName != null && !packageName.trim().isEmpty()) edit.setPackage(packageName);
+        return edit;
+    }
+
+    private static boolean resolves(PackageManager packages, Intent intent) {
+        return intent != null && intent.resolveActivity(packages) != null;
+    }
+
+    private static String cleanMime(String mimeType) {
+        return mimeType == null || mimeType.trim().isEmpty()
+                ? "application/octet-stream" : mimeType.trim();
+    }
+}
