+package com.pineapple.sage;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.util.Locale;
+
+/**
+ * Deterministic goal and route coordinator. It never executes privileged work itself; it chooses
+ * among Sage's existing allowlisted command engine, local Brain, paired Forge surface, or fallback.
+ */
+final class SageIntentCoordinator {
+    enum Specialist {
+        COORDINATOR,
+        PLANNER,
+        ENGINEER,
+        RESEARCHER,
+        QA,
+        MEMORY_MANAGER,
+        RECOVERY_HANDLER,
+        MEDIA_NAVIGATOR,
+        PACKAGE_INSPECTOR,
+        MODEL_ROUTER,
+        FORGE_MANAGER
+    }
+
+    static final class Plan {
+        final String request;
+        final String executionRequest;
+        final String goal;
+        final String intent;
+        final String tool;
+        final String routeHint;
+        final String verification;
+        final Specialist specialist;
+        final float confidence;
+        final boolean contextualFollowUp;
+        final boolean correction;
+
+        Plan(String request, String executionRequest, String goal, String intent,
+             String tool, String routeHint, String verification, Specialist specialist,
+             float confidence, boolean contextualFollowUp, boolean correction) {
+            this.request = clean(request);
+            this.executionRequest = clean(executionRequest);
+            this.goal = clean(goal);
+            this.intent = clean(intent);
+            this.tool = clean(tool);
+            this.routeHint = clean(routeHint);
+            this.verification = clean(verification);
+            this.specialist = specialist;
+            this.confidence = Math.max(0f, Math.min(1f, confidence));
+            this.contextualFollowUp = contextualFollowUp;
+            this.correction = correction;
+        }
+    }
+
+    private static final String PREFS = "sage_goal_coordinator_v1";
+
+    private SageIntentCoordinator() {}
+
+    static Plan understand(Context context, String request, boolean brainAvailable,
+                           boolean forgePaired) {
+        SharedPreferences preferences = prefs(context);
+        String cleaned = clean(request);
+        String normalized = normalize(cleaned);
+        String previousRequest = preferences.getString("last_execution_request", "");
+        String previousRoute = preferences.getString("last_route", "");
+
+        boolean correction = startsWithAny(normalized,
+                "no i meant ", "actually ", "instead ", "correction ");
+        boolean followUp = isFollowUp(normalized);
+        String execution = cleaned;
+        if (followUp && safeRepeat(previousRequest, previousRoute)) {
+            execution = previousRequest;
+        }
+
+        String goal = goalFor(cleaned, execution, correction, followUp);
+        String intent = intentFor(execution);
+        Specialist specialist = specialistFor(intent, execution);
+        String tool = toolFor(intent);
+        String route = routeFor(intent, brainAvailable, forgePaired);
+        String verification = verificationFor(intent);
+        float confidence = followUp && execution.equals(cleaned) ? 0.55f
+                : correction ? 0.92f : 0.96f;
+
+        Plan plan = new Plan(cleaned, execution, goal, intent, tool, route, verification,
+                specialist, confidence, followUp, correction);
+        preferences.edit()
+                .putString("last_request", cleaned)
+                .putString("last_execution_request", execution)
+                .putString("last_goal", goal)
+                .putString("last_intent", intent)
+                .putString("last_route_hint", route)
+                .putString("last_specialist", specialist.name())
+                .putLong("last_planned_at", System.currentTimeMillis())
+                .apply();
+        SageDiagnostics.appendEvent(context, "COORDINATOR",
+                "goal=" + goal + " intent=" + intent + " specialist=" + specialist.name()
+                        + " tool=" + tool + " route_hint=" + route
+                        + " confidence=" + String.format(Locale.US, "%.2f", confidence)
+                        + " follow_up=" + followUp + " correction=" + correction);
+        return plan;
+    }
+
+    static void recordOutcome(Context context, Plan plan, String route, boolean verified,
+                              String detail) {
+        String cleanRoute = clean(route);
+        prefs(context).edit()
+                .putString("last_route", cleanRoute)
+                .putBoolean("last_verified", verified)
+                .putString("last_outcome", clean(detail))
+                .putLong("last_completed_at", System.currentTimeMillis())
+                .apply();
+        SageDiagnostics.appendEvent(context, "COORDINATOR RESULT",
+                "goal=" + (plan == null ? "unknown" : plan.goal)
+                        + " route=" + cleanRoute + " verified=" + verified
+                        + " detail=" + clean(detail));
+    }
+
+    static String promptContext(Context context, String currentRequest) {
+        SharedPreferences preferences = prefs(context);
+        String goal = preferences.getString("last_goal", clean(currentRequest));
+        String intent = preferences.getString("last_intent", "conversation");
+        return "Current user goal: " + goal + "\n"
+                + "Intent: " + intent + "\n"
+                + "Answer the goal, not merely the literal wording. Do not claim an action succeeded "
+                + "unless Sage reports verified execution.";
+    }
+
+    static String lastSummary(Context context) {
+        SharedPreferences preferences = prefs(context);
+        String goal = preferences.getString("last_goal", "");
+        if (goal.isEmpty()) return "I do not have a current goal yet.";
+        return "I understand what you want to accomplish: " + goal
+                + ". Route: " + preferences.getString("last_route",
+                preferences.getString("last_route_hint", "fallback"))
+                + ". Verification: "
+                + (preferences.getBoolean("last_verified", false) ? "completed" : "not completed");
+    }
+
+    private static String goalFor(String request, String execution, boolean correction,
+                                  boolean followUp) {
+        if (followUp && !execution.equals(request)) return "repeat: " + execution;
+        String normalized = normalize(request);
+        if (correction) {
+            return "correct the previous understanding to: " + request.replaceFirst(
+                    "(?i)^(?:no[, ]+i meant|actually|instead|correction)\\s+", "");
+        }
+        if (normalized.startsWith("can you ")) return request.substring(8).trim();
+        if (normalized.startsWith("could you ")) return request.substring(10).trim();
+        if (normalized.startsWith("would you ")) return request.substring(10).trim();
+        if (normalized.startsWith("please ")) return request.substring(7).trim();
+        return request;
+    }
+
+    private static String intentFor(String request) {
+        String value = normalize(request);
+        if (containsAny(value, "remember", "memory", "prefer", "when i say",
+                "this device", "this project", "forget")) return "memory";
+        if (containsAny(value, "brain", "model", "gguf", "first token")) return "model";
+        if (containsAny(value, "apk", "package", "signer", "certificate")) return "package";
+        if (containsAny(value, "forge", "dell", "job", "repair", "diagnose")) return "recovery";
+        if (containsAny(value, "play", "pause", "song", "video", "media", "next")) return "media";
+        if (containsAny(value, "tap", "click", "open", "choose", "select", "screen",
+                "scroll", "type", "home", "back")) return "device_action";
+        if (containsAny(value, "surprise me", "bored", "idea", "creative", "prompt")) {
+            return "creative";
+        }
+        if (containsAny(value, "test", "verify", "check", "compare")) return "quality";
+        if (containsAny(value, "how", "why", "what", "who", "where", "explain")) {
+            return "knowledge";
+        }
+        return "conversation";
+    }
+
+    private static Specialist specialistFor(String intent, String request) {
+        switch (intent) {
+            case "memory": return Specialist.MEMORY_MANAGER;
+            case "model": return Specialist.MODEL_ROUTER;
+            case "package": return Specialist.PACKAGE_INSPECTOR;
+            case "recovery": return normalize(request).contains("forge")
+                    ? Specialist.FORGE_MANAGER : Specialist.RECOVERY_HANDLER;
+            case "media": return Specialist.MEDIA_NAVIGATOR;
+            case "quality": return Specialist.QA;
+            case "knowledge": return Specialist.RESEARCHER;
+            case "creative": return Specialist.PLANNER;
+            case "device_action": return Specialist.COORDINATOR;
+            default: return Specialist.COORDINATOR;
+        }
+    }
+
+    private static String toolFor(String intent) {
+        switch (intent) {
+            case "memory": return "Memory 2.0";
+            case "model": return "Model Router";
+            case "package": return "Package Lab";
+            case "recovery": return "Recovery / Forge";
+            case "media": return "Media Lab";
+            case "quality": return "QA diagnostics";
+            case "device_action": return "Android command engine";
+            default: return "conversation";
+        }
+    }
+
+    private static String routeFor(String intent, boolean brainAvailable, boolean forgePaired) {
+        if (intent.equals("recovery") && forgePaired) return "Dell Forge";
+        if (intent.equals("knowledge") || intent.equals("conversation") || intent.equals("creative")) {
+            return brainAvailable ? "tablet Brain" : "fallback";
+        }
+        return "command engine";
+    }
+
+    private static String verificationFor(String intent) {
+        if (intent.equals("device_action")) return "Android action result";
+        if (intent.equals("memory")) return "persistent storage commit";
+        if (intent.equals("model")) return "Brain health metrics";
+        if (intent.equals("package")) return "parsed identity and cryptographic hashes";
+        if (intent.equals("recovery")) return "signed Forge job status or local repair report";
+        return "displayed response";
+    }
+
+    private static boolean isFollowUp(String value) {
+        return value.equals("do that again") || value.equals("do it again")
+                || value.equals("same again") || value.equals("repeat that")
+                || value.equals("try that again") || value.equals("one more time");
+    }
+
+    private static boolean safeRepeat(String previous, String route) {
+        String value = normalize(previous);
+        if (value.isEmpty() || !"command engine".equals(route)) return false;
+        return !startsWithAny(value, "type ", "write ", "install ", "delete ",
+                "forget ", "clear memory", "scan ", "pair ", "revoke ");
+    }
+
+    private static boolean startsWithAny(String value, String... prefixes) {
+        for (String prefix : prefixes) if (value.startsWith(prefix)) return true;
+        return false;
+    }
+
+    private static boolean containsAny(String value, String... pieces) {
+        for (String piece : pieces) if (value.contains(piece)) return true;
+        return false;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String normalize(String value) {
+        return clean(value).toLowerCase(Locale.US).replaceAll("[^a-z0-9 ]", " ")
+                .replaceAll("\\s+", " ").trim();
+    }
+
+    private static String clean(String value) {
+        return value == null ? "" : value.replaceAll("\\s+", " ").trim();
+    }
+}
