diff -ruN '--exclude=build' '--exclude=.gradle' '--exclude=.cxx' '--exclude=assets' '--exclude=third_party' sage_build_second/app/src/main/java/com/pineapple/sage/SageIntentCoordinator.java sage_build/app/src/main/java/com/pineapple/sage/SageIntentCoordinator.java
--- sage_build_second/app/src/main/java/com/pineapple/sage/SageIntentCoordinator.java	1970-01-01 01:00:00.000000000 +0100
+++ sage_build/app/src/main/java/com/pineapple/sage/SageIntentCoordinator.java	2026-08-01 06:19:20.485019873 +0100
