diff -ruN a/app/src/main/java/com/pineapple/sage/SageBrainRequestPolicy.java b/app/src/main/java/com/pineapple/sage/SageBrainRequestPolicy.java
--- a/app/src/main/java/com/pineapple/sage/SageBrainRequestPolicy.java	1969-12-31 18:00:00.000000000 -0600
+++ b/app/src/main/java/com/pineapple/sage/SageBrainRequestPolicy.java	2026-08-08 22:51:28.154623534 -0500
@@ -0,0 +1,127 @@
+package com.pineapple.sage;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Request identity, immutable terminal state, and deterministic prompt relevance policy. */
+final class SageBrainRequestPolicy {
+    static final int SIMPLE_CHAR_BUDGET = 720;
+    static final int COMPLEX_CHAR_BUDGET = 2400;
+    private static final AtomicLong IDS = new AtomicLong(System.currentTimeMillis() << 10);
+
+    enum Terminal { ACTIVE, SUCCESS, ERROR, CANCELLED, TIMED_OUT }
+
+    static final class Lifecycle {
+        final long requestId = IDS.incrementAndGet();
+        final long generationId;
+        final long startedAtMs;
+        private Terminal terminal = Terminal.ACTIVE;
+        private long firstTokenAtMs = -1L;
+        private int generatedTokens;
+        private boolean watchdogActive = true;
+
+        Lifecycle(long generationId, long now) {
+            this.generationId = generationId;
+            this.startedAtMs = now;
+        }
+
+        synchronized boolean accepts(long request, long generation) {
+            return request == requestId && generation == generationId && terminal == Terminal.ACTIVE;
+        }
+
+        synchronized boolean token(long request, long generation, long now, int total) {
+            if (!accepts(request, generation) || total <= generatedTokens) return false;
+            if (firstTokenAtMs < 0L) firstTokenAtMs = now;
+            generatedTokens = total;
+            return true;
+        }
+
+        synchronized boolean finishSuccess(long request, long generation, int total) {
+            if (!accepts(request, generation) || total <= 0) return false;
+            generatedTokens = Math.max(generatedTokens, total);
+            terminal = Terminal.SUCCESS;
+            watchdogActive = false;
+            return true;
+        }
+
+        synchronized boolean finish(long request, long generation, Terminal value) {
+            if (!accepts(request, generation)) return false;
+            terminal = value;
+            watchdogActive = false;
+            return true;
+        }
+
+        synchronized long firstTokenLatencyMs() {
+            return firstTokenAtMs < 0L ? -1L : Math.max(0L, firstTokenAtMs - startedAtMs);
+        }
+        synchronized int generatedTokens() { return generatedTokens; }
+        synchronized Terminal terminal() { return terminal; }
+        synchronized boolean watchdogActive() { return watchdogActive; }
+    }
+
+    static final class Prompt {
+        final String text;
+        final int budget;
+        final boolean truncated;
+        final int selectedContext;
+        final int selectedMemories;
+        Prompt(String text, int budget, boolean truncated, int contexts, int memories) {
+            this.text=text; this.budget=budget; this.truncated=truncated;
+            this.selectedContext=contexts; this.selectedMemories=memories;
+        }
+    }
+
+    static Prompt compact(String user, String tone, List<String> context, List<String> memories) {
+        String request = clean(user);
+        boolean complex = requiresFullContext(request);
+        int budget = complex ? COMPLEX_CHAR_BUDGET : SIMPLE_CHAR_BUDGET;
+        StringBuilder out = new StringBuilder();
+        append(out, clean(tone), budget);
+        int selectedContext = appendRelevant(out, "Relevant context: ", request, context,
+                complex ? 4 : 1, budget);
+        int selectedMemories = appendRelevant(out, "Relevant memory: ", request, memories,
+                complex ? 4 : 1, budget);
+        String userLine = "User: " + request + "\n/no_think";
+        boolean truncated = out.length() + userLine.length() > budget;
+        if (truncated) out.setLength(Math.max(0, budget - userLine.length()));
+        out.append(userLine);
+        return new Prompt(out.toString(), budget, truncated, selectedContext, selectedMemories);
+    }
+
+    private static int appendRelevant(StringBuilder out, String label, String user,
+                                      List<String> values, int maximum, int budget) {
+        if (values == null || values.isEmpty()) return 0;
+        List<String> ranked = new ArrayList<>();
+        for (String value : values) if (relevant(user, value)) ranked.add(clean(value));
+        Collections.sort(ranked, (a,b) -> Integer.compare(score(user,b), score(user,a)));
+        int count=0;
+        for (String value : ranked) {
+            if (count >= maximum || value.isEmpty()) break;
+            String line=label + value + "\n";
+            if (out.length() + line.length() > budget) break;
+            out.append(line); count++;
+        }
+        return count;
+    }
+
+    private static boolean relevant(String user, String value) { return score(user,value) > 0; }
+    private static int score(String user, String value) {
+        String a=clean(user).toLowerCase(Locale.US), b=clean(value).toLowerCase(Locale.US);
+        int score=0;
+        for (String word : a.split("[^a-z0-9]+")) if (word.length() >= 4 && b.contains(word)) score++;
+        return score;
+    }
+    private static boolean requiresFullContext(String value) {
+        String v=value.toLowerCase(Locale.US);
+        return v.contains("based on our conversation") || v.contains("compare")
+                || v.contains("summarize") || v.contains("what did i") || v.contains("remember");
+    }
+    private static void append(StringBuilder out,String value,int budget) {
+        if (value.isEmpty()) return;
+        out.append(value,0,Math.min(value.length(),budget)).append('\n');
+    }
+    private static String clean(String value) { return value == null ? "" : value.trim().replaceAll("\\s+"," "); }
+}
