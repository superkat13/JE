+    private void playVoiceResponse(SageMediaResponseStore.Entry response) {
+        stopWakeListening();
+        destroyCommandRecognizer();
+        if (textToSpeech != null) {
+            textToSpeech.stop();
+        }
+        releaseResponsePlayer();
+        speaking = true;
+        lastWakePreview = "";
+        lastSpokenForEcho = "";
+        ignoreRecognitionUntilMs = System.currentTimeMillis() + WAKE_ECHO_GUARD_MS;
+        String label = response.displayName == null || response.displayName.trim().isEmpty()
+                ? "the saved voice clip"
+                : response.displayName;
+        broadcastLine("Sage", "Playing " + label + " for “" + response.phrase + ".”");
+        broadcastStatus("Playing custom voice");
+        updateNotification("Playing custom voice");
+
+        MediaPlayer player = new MediaPlayer();
+        responsePlayer = player;
+        try {
+            player.setAudioAttributes(new AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_ASSISTANT)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                    .build());
+            player.setDataSource(this, Uri.parse(response.uri));
+            player.setOnPreparedListener(prepared -> {
+                if (prepared != responsePlayer || stopRequested) {
+                    releaseResponsePlayer();
+                    speaking = false;
+                    if (stopRequested) {
+                        stopSelf();
+                    }
+                    return;
+                }
+                int durationMs = prepared.getDuration();
+                if (durationMs > 0) {
+                    ignoreRecognitionUntilMs = Math.max(
+                            ignoreRecognitionUntilMs,
+                            System.currentTimeMillis() + durationMs + WAKE_ECHO_GUARD_MS
+                    );
+                }
+                prepared.start();
+            });
+            player.setOnCompletionListener(completed -> {
+                if (completed != responsePlayer) {
+                    return;
+                }
+                releaseResponsePlayer();
+                afterSpeaking();
+            });
+            player.setOnErrorListener((failed, what, extra) -> {
+                if (failed == responsePlayer) {
+                    failVoiceResponse(response);
+                }
+                return true;
+            });
+            player.prepareAsync();
+        } catch (Exception error) {
+            failVoiceResponse(response);
+        }
+    }
+
+    private void failVoiceResponse(SageMediaResponseStore.Entry response) {
+        releaseResponsePlayer();
+        speaking = false;
+        String message = "I could not play that saved voice clip. "
+                + "If the file was moved or Drive access changed, choose it again under custom voice responses.";
+        broadcastLine("Sage", message);
+        speak(message);
+    }
+
+    private void releaseResponsePlayer() {
+        MediaPlayer player = responsePlayer;
+        responsePlayer = null;
+        if (player == null) {
+            return;
+        }
+        player.setOnPreparedListener(null);
+        player.setOnCompletionListener(null);
+        player.setOnErrorListener(null);
+        try {
+            if (player.isPlaying()) {
+                player.stop();
+            }
+        } catch (IllegalStateException ignored) {
+        }
+        player.release();
+    }
