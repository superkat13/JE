+package com.pineapple.sage;
+
+import android.content.SharedPreferences;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+final class SageMediaResponseStore {
+    private static final String PREFERENCE_KEY = "sage_voice_responses";
+    private static final String SEPARATOR = "\t";
+
+    static final class Entry {
+        final String normalizedPhrase;
+        final String phrase;
+        final String uri;
+        final String displayName;
+
+        Entry(String normalizedPhrase, String phrase, String uri, String displayName) {
+            this.normalizedPhrase = normalizedPhrase;
+            this.phrase = phrase;
+            this.uri = uri;
+            this.displayName = displayName;
+        }
+    }
+
+    private SageMediaResponseStore() {
+    }
+
+    static boolean save(
+            SharedPreferences preferences,
+            String phrase,
+            String uri,
+            String displayName
+    ) {
+        String cleanedPhrase = cleanField(phrase);
+        String normalized = normalize(cleanedPhrase);
+        String cleanedUri = cleanField(uri);
+        String cleanedName = cleanField(displayName);
+        if (normalized.isEmpty() || cleanedUri.isEmpty()) {
+            return false;
+        }
+        if (cleanedName.isEmpty()) {
+            cleanedName = "Selected voice clip";
+        }
+        Set<String> saved = new HashSet<>(
+                preferences.getStringSet(PREFERENCE_KEY, new HashSet<>())
+        );
+        saved.removeIf(raw -> {
+            Entry entry = parse(raw);
+            return entry != null && entry.normalizedPhrase.equals(normalized);
+        });
+        saved.add(
+                normalized + SEPARATOR
+                        + cleanedPhrase + SEPARATOR
+                        + cleanedUri + SEPARATOR
+                        + cleanedName
+        );
+        return preferences.edit().putStringSet(PREFERENCE_KEY, saved).commit();
+    }
+
+    static Entry find(SharedPreferences preferences, String spokenPhrase) {
+        String normalized = normalize(spokenPhrase);
+        if (normalized.isEmpty()) {
+            return null;
+        }
+        for (Entry entry : list(preferences)) {
+            if (entry.normalizedPhrase.equals(normalized)) {
+                return entry;
+            }
+        }
+        return null;
+    }
+
+    static List<Entry> list(SharedPreferences preferences) {
+        Set<String> saved = preferences.getStringSet(PREFERENCE_KEY, new HashSet<>());
+        List<Entry> entries = new ArrayList<>();
+        if (saved != null) {
+            for (String raw : saved) {
+                Entry entry = parse(raw);
+                if (entry != null) {
+                    entries.add(entry);
+                }
+            }
+        }
+        Collections.sort(
+                entries,
+                (left, right) -> left.phrase.compareToIgnoreCase(right.phrase)
+        );
+        return entries;
+    }
+
+    static boolean clear(SharedPreferences preferences) {
+        return preferences.edit().remove(PREFERENCE_KEY).commit();
+    }
+
+    static String normalize(String value) {
+        return value == null
+                ? ""
+                : value.toLowerCase(Locale.US)
+                        .replaceAll("[^a-z0-9 ]", " ")
+                        .replaceAll("\\s+", " ")
+                        .trim();
+    }
+
+    private static Entry parse(String raw) {
+        if (raw == null) {
+            return null;
+        }
+        String[] parts = raw.split(SEPARATOR, 4);
+        if (parts.length != 4 || parts[0].isEmpty() || parts[2].isEmpty()) {
+            return null;
+        }
+        return new Entry(parts[0], parts[1], parts[2], parts[3]);
+    }
+
+    private static String cleanField(String value) {
+        return value == null
+                ? ""
+                : value.replace('\t', ' ')
+                        .replace('\n', ' ')
+                        .replace('\r', ' ')
+                        .replaceAll("\\s+", " ")
+                        .trim();
+    }
+}

