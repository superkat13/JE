+    private void importModelOnWorker(Uri uri, String displayName, LoadCallback callback) {
+        if (!NATIVE_AVAILABLE) {
+            postLoadError(callback, "This APK does not contain the local brain engine.");
+            return;
+        }
+        if (uri == null) {
+            postLoadError(callback, "No model file was selected.");
+            return;
+        }
+        String name = clean(displayName);
+        if (name.isEmpty()) {
+            name = queryDisplayName(uri);
+        }
+        if (!name.isEmpty() && !name.toLowerCase(Locale.US).endsWith(".gguf")) {
+            postLoadError(callback, "Choose a GGUF model file. Its name should end in .gguf.");
+            return;
+        }
+        long reportedSize = querySize(uri);
+        if (reportedSize > 0L
+                && (reportedSize < MIN_MODEL_BYTES || reportedSize > MAX_MODEL_BYTES)) {
+            postLoadError(
+                    callback,
+                    "That model is " + formatBytes(reportedSize)
+                            + ". Sage supports local models from 16 MB through 3.5 GB on this tablet."
+            );
+            return;
+        }
+        long required = (reportedSize > 0L ? reportedSize : RECOMMENDED_MODEL_BYTES)
+                + IMPORT_HEADROOM_BYTES;
+        long available = availableStorageBytes();
+        if (available < required) {
+            postLoadError(
+                    callback,
+                    "Not enough free storage to import that model. Sage needs about "
+                            + formatBytes(required)
+                            + " free during import; Android reports "
+                            + formatBytes(available)
+                            + "."
+            );
+            return;
+        }
+
+        File directory = brainDirectory();
+        if (!directory.exists() && !directory.mkdirs()) {
+            postLoadError(callback, "Android could not create Sage's private brain folder.");
+            return;
+        }
+        File temporary = new File(directory, "incoming-model.gguf");
+        if (temporary.exists() && !temporary.delete()) {
+            postLoadError(callback, "Sage could not clear an unfinished model import.");
+            return;
+        }
+
+        postLoadStatus(callback, "Copying model into Sage — keep the app open");
+        long copied = 0L;
+        byte[] firstBytes = new byte[4];
+        int firstCount = 0;
+        MessageDigest digest;
+        try {
+            digest = MessageDigest.getInstance("SHA-256");
+        } catch (Exception problem) {
+            postLoadError(callback, "Android could not start model verification.");
+            return;
+        }
+
+        try (InputStream input = context.getContentResolver().openInputStream(uri);
+             FileOutputStream output = new FileOutputStream(temporary)) {
+            if (input == null) {
+                throw new IllegalStateException("The selected file could not be opened.");
+            }
+            byte[] buffer = new byte[1024 * 1024];
+            long nextProgress = 64L * 1024L * 1024L;
+            int count;
+            while ((count = input.read(buffer)) >= 0) {
+                if (count == 0) {
+                    continue;
+                }
+                if (firstCount < firstBytes.length) {
+                    int amount = Math.min(firstBytes.length - firstCount, count);
+                    System.arraycopy(buffer, 0, firstBytes, firstCount, amount);
+                    firstCount += amount;
+                }
+                output.write(buffer, 0, count);
+                digest.update(buffer, 0, count);
+                copied += count;
+                if (copied >= nextProgress) {
+                    String progress = reportedSize > 0L
+                            ? "Copying model: "
+                            + Math.min(99L, (copied * 100L) / reportedSize)
+                            + "%"
+                            : "Copying model: " + formatBytes(copied);
+                    postLoadStatus(callback, progress);
+                    nextProgress += 64L * 1024L * 1024L;
+                }
+                if (copied > MAX_MODEL_BYTES) {
+                    throw new IllegalArgumentException("The selected model is larger than 3.5 GB.");
+                }
+            }
+            output.getFD().sync();
+        } catch (Exception problem) {
+            temporary.delete();
+            postLoadError(callback, "Model import stopped: " + safeProblem(problem));
+            return;
+        }
+
+        if (copied < MIN_MODEL_BYTES
+                || firstCount < 4
+                || firstBytes[0] != 'G'
+                || firstBytes[1] != 'G'
+                || firstBytes[2] != 'U'
+                || firstBytes[3] != 'F') {
+            temporary.delete();
+            postLoadError(callback, "That file is not a readable GGUF language model.");
+            return;
+        }
+
+        String sha256 = hex(digest.digest());
+        postLoadStatus(callback, "Verifying and loading local model");
+        nativeUnloadModel();
+        try {
+            Files.move(
+                    temporary.toPath(),
+                    modelFile().toPath(),
+                    StandardCopyOption.REPLACE_EXISTING,
+                    StandardCopyOption.ATOMIC_MOVE
+            );
+        } catch (Exception atomicProblem) {
+            try {
+                Files.move(
+                        temporary.toPath(),
+                        modelFile().toPath(),
+                        StandardCopyOption.REPLACE_EXISTING
+                );
+            } catch (Exception moveProblem) {
+                temporary.delete();
+                postLoadError(callback, "Sage could not finish saving the model.");
+                return;
+            }
+        }
