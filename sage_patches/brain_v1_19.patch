+            return "";
+        }
+        state = State.LOADING;
+        status = "Loading " + preferences.getString(KEY_MODEL_NAME, "local GGUF model");
+        boolean loaded;
+        try {
+            loaded = nativeLoadModel(model.getAbsolutePath());
+        } catch (Throwable problem) {
+            return fail("Local model could not load: " + safeProblem(problem));
+        }
+        if (!loaded) {
+            return fail(nativeErrorOr("Local model could not load."));
+        }
+        state = State.READY;
+        status = "Sage Brain ready";
+        lastError = "";
+        return "";
+    }
+
+    private Reply parseReply(String original, String raw) {
+        String cleaned = cleanModelOutput(raw);
+        String action = valueAfterMarker(cleaned, "ACTION");
+        if (!action.isEmpty() && isSafeProposedAction(original, action)) {
+            return Reply.action(limit(action, 260));
+        }
+        String answer = valueAfterMarker(cleaned, "ANSWER");
+        if (answer.isEmpty()) {
+            answer = cleaned
+                    .replaceFirst("(?i)^ACTION\\s*[|:]\\s*", "")
+                    .replaceFirst("(?i)^ANSWER\\s*[|:]\\s*", "");
+        }
+        if (!action.isEmpty() && answer.equals(action)) {
+            answer = "I understood the request, but I would rather not guess at a tablet action.";
+        }
+        return Reply.answer(limit(clean(answer), MAX_VISIBLE_REPLY_CHARS));
+    }
+
+    private boolean isSafeProposedAction(String original, String proposed) {
+        String user = normalize(original);
+        String action = normalize(proposed);
+        if (action.isEmpty() || action.length() > 260
+                || action.contains("delete ")
+                || action.contains("uninstall ")
+                || action.contains("clear memory")
+                || action.contains("forget everything")
+                || action.contains("password")
+                || action.contains("purchase ")
+                || action.contains("buy ")
+                || action.contains("pay ")) {
+            return false;
+        }
+        if (startsWithAny(action, "type ", "write ")) {
+            return containsAny(user, "type", "write", "enter", "put");
+        }
+        if (startsWithAny(action, "tap ", "click ", "press ", "choose ", "select ", "pick ")) {
+            return containsAny(user, "tap", "click", "press", "choose", "select", "pick", "hit");
+        }
+        if (startsWithAny(action, "remember ", "note ")) {
+            return containsAny(user, "remember", "note", "save");
+        }
+        if (startsWithAny(action, "open ", "go to ", "search ", "search for ",
+                "look up ", "find ", "youtube ", "search youtube for ")) {
+            return containsAny(user, "open", "go", "take me", "search", "look", "find", "youtube");
+        }
+        if (action.equals("home") || action.equals("go home")) {
+            return containsAny(user, "home");
+        }
+        if (action.equals("back") || action.equals("go back")) {
+            return containsAny(user, "back");
+        }
+        if (action.equals("recents") || action.equals("recent apps")) {
+            return containsAny(user, "recent", "apps");
+        }
+        if (action.equals("scroll down") || action.equals("scroll up")) {
+            return containsAny(user, "scroll", "down", "up");
+        }
+        if (startsWithAny(action, "volume ", "mute", "unmute", "pause", "next", "previous")) {
+            return containsAny(user, "volume", "louder", "quieter", "mute", "pause",
+                    "play", "next", "skip", "previous");
+        }
+        return action.equals("show notifications") && containsAny(user, "notification");
+    }
+
+    private String buildSystemPrompt() {
+        return "You are Sage, a private local voice assistant on an Android tablet. "
+                + "Be useful, concise, warm, and truthful. Decide whether the user wants a tablet "
+                + "action or a spoken answer. Return exactly one line in one of these formats: "
+                + "ACTION|canonical command OR ANSWER|short answer. "
+                + "Allowed canonical commands are: open TARGET; go to TARGET; search for QUERY; "
+                + "search YouTube for QUERY; tap LABEL; type TEXT; home; back; recents; scroll up; "
+                + "scroll down; show notifications; volume up; volume down; mute; unmute; pause; "
+                + "next; previous; remember NOTE. Use ACTION only for a direct user request. "
+                + "Never invent an action, current fact, or ability. Never use Markdown. "
+                + "Keep answers to two short sentences.";
+    }
+
+    private String buildUserPrompt(String userText) {
+        StringBuilder prompt = new StringBuilder();
+        String memories = memorySummary();
+        if (!memories.isEmpty()) {
+            prompt.append("Saved user notes: ").append(memories).append('\n');
+        }
+        synchronized (recentTurns) {
+            if (!recentTurns.isEmpty()) {
+                prompt.append("Recent conversation:\n");
+                for (String turn : recentTurns) {
+                    prompt.append(turn).append('\n');
+                }
+            }
+        }
+        prompt.append("User said: ").append(limit(userText, 700)).append("\n/no_think");
+        return prompt.toString();
+    }
+
+    private String memorySummary() {
+        Set<String> saved = preferences.getStringSet("memory_items", new HashSet<>());
+        if (saved == null || saved.isEmpty()) {
+            return "";
+        }
+        List<String> notes = new ArrayList<>(saved);
+        notes.sort(String.CASE_INSENSITIVE_ORDER);
+        StringBuilder summary = new StringBuilder();
+        for (String note : notes) {
+            if (summary.length() > 0) {
+                summary.append("; ");
+            }
+            summary.append(limit(clean(note), 100));
+            if (summary.length() >= 420) {
+                break;
+            }
+        }
+        return limit(summary.toString(), 420);
+    }
+
+    private void rememberTurn(String turn) {
+        synchronized (recentTurns) {
+            recentTurns.addLast(limit(turn, 320));
+            while (recentTurns.size() > 6) {
+                recentTurns.removeFirst();
+            }
+        }
+    }
+
+    private String modelSummary() {
+        String name = preferences.getString(KEY_MODEL_NAME, "Local GGUF model");
+        long size = preferences.getLong(KEY_MODEL_SIZE, modelFile().length());
+        return "Sage Brain ready with " + name + " (" + formatBytes(size) + ").";
+    }
+
+    private String fail(String message) {
+        state = State.ERROR;
+        status = clean(message);
+        lastError = status;
+        SageDiagnostics.recordError(context, "Sage Brain: " + status);
+        return status;
+    }
+
+    private File brainDirectory() {
+        return new File(context.getFilesDir(), "brain");
+    }
+
+    private File modelFile() {
+        return new File(brainDirectory(), "sage-brain.gguf");
+    }
+
+    private long availableStorageBytes() {
+        try {
+            return new StatFs(context.getFilesDir().getAbsolutePath()).getAvailableBytes();
+        } catch (Exception ignored) {
+            return 0L;
+        }
+    }
+
+    private long querySize(Uri uri) {
+        Cursor cursor = null;
+        try {
+            cursor = context.getContentResolver().query(uri, null, null, null, null);
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.SIZE);
+                if (index >= 0 && !cursor.isNull(index)) {
+                    return cursor.getLong(index);
+                }
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+        }
+        return -1L;
+    }
+
+    private String queryDisplayName(Uri uri) {
+        Cursor cursor = null;
+        try {
+            cursor = context.getContentResolver().query(uri, null, null, null, null);
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (index >= 0) {
+                    return clean(cursor.getString(index));
+                }
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+        }
+        return "";
+    }
+
+    private String nativeErrorOr(String fallback) {
+        try {
+            String nativeError = nativeLastError();
+            return nativeError == null || nativeError.trim().isEmpty()
+                    ? fallback
+                    : clean(nativeError);
+        } catch (Throwable ignored) {
+            return fallback;
+        }
+    }
+
+    private String cleanModelOutput(String raw) {
+        String value = raw == null ? "" : raw;
+        value = value.replaceAll("(?is)<think>.*?</think>", " ");
+        value = value.replaceAll("(?is)^.*?</think>", " ");
+        value = value.replace("```", " ").trim();
+        int doubleBreak = value.indexOf("\n\n");
+        if (doubleBreak > 0) {
+            value = value.substring(0, doubleBreak);
+        }
+        return clean(value);
+    }
+
+    private static String valueAfterMarker(String value, String marker) {
+        String[] lines = value.split("\\r?\\n");
+        for (String line : lines) {
+            String trimmed = clean(line);
+            if (trimmed.matches("(?i)^" + marker + "\\s*[|:].*")) {
+                return clean(trimmed.replaceFirst(
+                        "(?i)^" + marker + "\\s*[|:]\\s*",
+                        ""
+                ));
+            }
+        }
+        return "";
+    }
+
+    private void postLoadStatus(LoadCallback callback, String message) {
+        status = clean(message);
+        if (callback != null) {
+            mainHandler.post(() -> callback.onStatus(status));
+        }
+    }
+
+    private void postLoadReady(LoadCallback callback, String message) {
+        if (callback != null) {
+            mainHandler.post(() -> callback.onReady(message));
+        }
+    }
+
+    private void postLoadError(LoadCallback callback, String message) {
+        String cleaned = fail(message);
+        if (callback != null) {
+            mainHandler.post(() -> callback.onError(cleaned));
+        }
+    }
+
+    private void postReplyStatus(ReplyCallback callback, String message) {
+        if (callback != null) {
+            mainHandler.post(() -> callback.onStatus(message));
+        }
+    }
+
+    private void postReply(ReplyCallback callback, Reply reply) {
+        if (callback != null) {
+            mainHandler.post(() -> callback.onReply(reply));
+        }
+    }
+
+    private void postReplyError(ReplyCallback callback, String message) {
+        if (callback != null) {
+            mainHandler.post(() -> callback.onError(clean(message)));
+        }
+    }
+
+    private static String normalize(String value) {
+        return clean(value).toLowerCase(Locale.US)
+                .replaceAll("[^a-z0-9. ]", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+
+    private static boolean startsWithAny(String value, String... prefixes) {
+        for (String prefix : prefixes) {
+            if (value.equals(prefix) || value.startsWith(prefix)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean containsAny(String value, String... pieces) {
+        String padded = " " + value + " ";
+        for (String piece : pieces) {
+            if (piece.contains(" ")) {
+                if (value.contains(piece)) {
+                    return true;
+                }
+            } else if (padded.contains(" " + piece + " ")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String formatBytes(long bytes) {
+        if (bytes <= 0L) {
+            return "unknown";
+        }
+        double gib = bytes / (1024.0 * 1024.0 * 1024.0);
+        if (gib >= 1.0) {
+            return String.format(Locale.US, "%.2f GB", gib);
+        }
+        return String.format(Locale.US, "%.0f MB", bytes / (1024.0 * 1024.0));
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder result = new StringBuilder(bytes.length * 2);
+        for (byte value : bytes) {
+            result.append(String.format(Locale.US, "%02x", value & 0xff));
+        }
+        return result.toString();
+    }
+
+    private static String limit(String value, int maximum) {
+        String cleaned = clean(value);
+        if (cleaned.length() <= maximum) {
+            return cleaned;
+        }
+        return cleaned.substring(0, maximum).trim() + "…";
+    }
+
+    private static String safeProblem(Throwable problem) {
+        if (problem == null) {
+            return "unknown error";
+        }
+        String message = clean(problem.getMessage());
+        return message.isEmpty() ? problem.getClass().getSimpleName() : message;
+    }
+
+    private static String clean(String value) {
+        return value == null
+                ? ""
+                : value.replace('\u0000', ' ').replaceAll("\\s+", " ").trim();
+    }
+
+    private static native boolean nativeLoadModel(String path);
+    private static native String nativeGenerate(String systemPrompt, String userPrompt, int maxTokens);
+    private static native void nativeUnloadModel();
+    private static native String nativeLastError();
+}
