+    private String ensureLoadedOnWorker() {
+        if (!NATIVE_AVAILABLE) {
+            return fail("Brain engine unavailable: " + NATIVE_LOAD_ERROR);
+        }
+        if (!isEnabled()) {
+            state = State.DISABLED;
+            return fail("Sage Brain is turned off.");
+        }
+        File model = modelFile();
+        if (!model.isFile() || model.length() < MIN_MODEL_BYTES) {
+            state = State.NOT_CONFIGURED;
