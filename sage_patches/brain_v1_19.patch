+/**
+ * Owns Sage's optional on-device GGUF language model.
+ *
+ * The model is deliberately separated from SageCommandEngine. Known commands always run through
+ * the deterministic command engine first. The model only interprets unmatched language, and every
+ * proposed tablet action is sent back through the existing command allow-list before it can run.
+ */
+public final class SageBrainManager {
+    public interface LoadCallback {
+        void onStatus(String status);
+        void onReady(String summary);
+        void onError(String message);
+    }
+
+    public interface ReplyCallback {
+        void onStatus(String status);
+        void onReply(Reply reply);
+        void onError(String message);
+    }
+
+    public static final class Reply {
+        public final boolean action;
+        public final String text;
+
+        private Reply(boolean action, String text) {
+            this.action = action;
+            this.text = text;
+        }
+
+        public static Reply action(String command) {
+            return new Reply(true, command);
+        }
+
+        public static Reply answer(String answer) {
+            return new Reply(false, answer);
+        }
+    }
+
+    private enum State {
+        NOT_CONFIGURED,
+        DISABLED,
+        LOADING,
+        READY,
+        ERROR
+    }
+
+    public static final String RECOMMENDED_MODEL_NAME = "Qwen3-1.7B-Q8_0.gguf";
+    public static final String RECOMMENDED_MODEL_URL =
+            "https://huggingface.co/Qwen/Qwen3-1.7B-GGUF/resolve/main/"
+                    + RECOMMENDED_MODEL_NAME
+                    + "?download=true";
+    public static final String RECOMMENDED_MODEL_SHA256 =
+            "061b54daade076b5d3362dac252678d17da8c68f07560be70818cace6590cb1a";
+    public static final long RECOMMENDED_MODEL_BYTES = 1_830_000_000L;
+
+    private static final String PREFS_NAME = "sage_state";
+    private static final String KEY_ENABLED = "brain_enabled";
+    private static final String KEY_MODEL_NAME = "brain_model_name";
+    private static final String KEY_MODEL_SIZE = "brain_model_size";
+    private static final String KEY_MODEL_SHA256 = "brain_model_sha256";
+    private static final long MIN_MODEL_BYTES = 16L * 1024L * 1024L;
+    private static final long MAX_MODEL_BYTES = 3_500L * 1024L * 1024L;
+    private static final long IMPORT_HEADROOM_BYTES = 512L * 1024L * 1024L;
+    private static final int MAX_REPLY_TOKENS = 96;
+    private static final int MAX_VISIBLE_REPLY_CHARS = 520;
+
+    private static volatile SageBrainManager instance;
+    private static final boolean NATIVE_AVAILABLE;
+    private static final String NATIVE_LOAD_ERROR;
+
+    static {
+        boolean loaded = false;
+        String error = "";
+        try {
+            System.loadLibrary("sage-brain");
+            loaded = true;
+        } catch (Throwable problem) {
+            error = problem.getMessage();
+            if (error == null || error.trim().isEmpty()) {
+                error = problem.getClass().getSimpleName();
+            }
+        }
+        NATIVE_AVAILABLE = loaded;
+        NATIVE_LOAD_ERROR = error;
+    }
+
+    private final Context context;
+    private final SharedPreferences preferences;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor(runnable -> {
+        Thread thread = new Thread(runnable, "Sage-Brain");
+        thread.setPriority(Thread.NORM_PRIORITY - 1);
+        return thread;
+    });
+    private final ArrayDeque<String> recentTurns = new ArrayDeque<>();
+
+    private volatile State state = State.NOT_CONFIGURED;
+    private volatile String status = "No local brain model selected";
+    private volatile String lastError = "";
+
+    private SageBrainManager(Context context) {
+        this.context = context.getApplicationContext();
+        this.preferences = this.context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+        if (!isConfigured()) {
+            state = State.NOT_CONFIGURED;
+        } else if (!isEnabled()) {
+            state = State.DISABLED;
+        } else {
+            status = "Brain model saved — loading when needed";
+        }
+    }
+
+    public static SageBrainManager get(Context context) {
+        SageBrainManager current = instance;
+        if (current != null) {
+            return current;
+        }
+        synchronized (SageBrainManager.class) {
+            if (instance == null) {
+                instance = new SageBrainManager(context);
+            }
+            return instance;
+        }
+    }
+
+    public boolean isConfigured() {
+        File model = modelFile();
+        return model.isFile() && model.length() >= MIN_MODEL_BYTES;
+    }
+
+    public boolean isEnabled() {
+        return preferences.getBoolean(KEY_ENABLED, true);
+    }
+
+    public boolean canAnswer() {
+        return NATIVE_AVAILABLE && isConfigured() && isEnabled();
+    }
+
+    public boolean isReady() {
+        return state == State.READY;
+    }
+
+    public boolean isLoading() {
+        return state == State.LOADING;
+    }
+
+    public String getStatusSummary() {
+        if (!NATIVE_AVAILABLE) {
+            return "Brain engine unavailable in this build: " + NATIVE_LOAD_ERROR;
+        }
+        if (!isConfigured()) {
+            return "No model installed. Recommended: "
+                    + RECOMMENDED_MODEL_NAME
+                    + " (1.83 GB). Free app storage: "
+                    + formatBytes(availableStorageBytes())
+                    + ".";
+        }
+        String name = preferences.getString(KEY_MODEL_NAME, "Local GGUF model");
+        long size = preferences.getLong(KEY_MODEL_SIZE, modelFile().length());
+        String mode = !isEnabled()
+                ? "OFF"
+                : state == State.READY
+                ? "READY"
+                : state == State.LOADING
+                ? "LOADING"
+                : "saved";
+        String summary = "Sage Brain " + mode + " • " + name + " • " + formatBytes(size);
+        if (!lastError.isEmpty()) {
+            summary += "\nLast brain error: " + lastError;
+        } else if (state != State.READY && isEnabled()) {
+            summary += "\n" + status;
+        }
+        return summary;
+    }
+
+    public void setEnabled(boolean enabled) {
+        preferences.edit().putBoolean(KEY_ENABLED, enabled).apply();
+        if (!enabled) {
+            worker.execute(() -> {
+                if (NATIVE_AVAILABLE) {
+                    nativeUnloadModel();
+                }
+                state = State.DISABLED;
+                status = "Sage Brain is off";
+            });
+        } else if (isConfigured()) {
+            state = State.NOT_CONFIGURED;
+            status = "Brain model saved — loading when needed";
+        }
+    }
+
+    public void prepareAsync(LoadCallback callback) {
+        worker.execute(() -> {
+            postLoadStatus(callback, "Loading Sage Brain");
+            String error = ensureLoadedOnWorker();
+            if (error.isEmpty()) {
+                postLoadReady(callback, modelSummary());
+            } else {
+                postLoadError(callback, error);
+            }
+        });
+    }
+
+    public void importModelAsync(Uri uri, String displayName, LoadCallback callback) {
+        worker.execute(() -> importModelOnWorker(uri, displayName, callback));
+    }
+
+    public void removeModelAsync(LoadCallback callback) {
+        worker.execute(() -> {
+            postLoadStatus(callback, "Removing local brain model");
+            if (NATIVE_AVAILABLE) {
+                nativeUnloadModel();
+            }
+            File model = modelFile();
+            boolean removed = !model.exists() || model.delete();
+            if (!removed) {
+                postLoadError(callback, "Android could not remove the local model file.");
+                return;
+            }
+            preferences.edit()
+                    .remove(KEY_MODEL_NAME)
+                    .remove(KEY_MODEL_SIZE)
+                    .remove(KEY_MODEL_SHA256)
+                    .apply();
+            state = State.NOT_CONFIGURED;
+            status = "No local brain model selected";
+            lastError = "";
+            postLoadReady(callback, "Local brain model removed.");
+        });
+    }
+
+    public void askAsync(String userText, ReplyCallback callback) {
+        String cleaned = clean(userText);
+        if (cleaned.isEmpty()) {
+            postReplyError(callback, "I did not receive enough words for Sage Brain.");
+            return;
+        }
+        worker.execute(() -> {
+            postReplyStatus(callback, isReady()
+                    ? "Sage Brain is thinking"
+                    : "Loading Sage Brain for this request");
+            String loadError = ensureLoadedOnWorker();
+            if (!loadError.isEmpty()) {
+                postReplyError(callback, loadError);
+                return;
+            }
+            String systemPrompt = buildSystemPrompt();
+            String userPrompt = buildUserPrompt(cleaned);
+            String raw;
+            try {
+                raw = nativeGenerate(systemPrompt, userPrompt, MAX_REPLY_TOKENS);
+            } catch (Throwable problem) {
+                raw = "";
+                lastError = "Brain generation failed: " + safeProblem(problem);
+            }
+            if (raw == null || raw.trim().isEmpty()) {
+                String error = nativeErrorOr("The local model did not return an answer.");
+                state = State.ERROR;
+                status = error;
+                lastError = error;
+                postReplyError(callback, error);
+                return;
+            }
+            Reply reply = parseReply(cleaned, raw);
+            if (reply.text.isEmpty()) {
+                postReplyError(callback, "The local model returned an unreadable answer.");
+                return;
+            }
+            rememberTurn("User: " + cleaned);
+            rememberTurn("Sage: " + reply.text);
+            postReply(callback, reply);
+        });
+    }
