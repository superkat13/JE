+        String savedName = name.isEmpty() ? "Local GGUF model" : name;
+        preferences.edit()
+                .putBoolean(KEY_ENABLED, true)
+                .putString(KEY_MODEL_NAME, savedName)
+                .putLong(KEY_MODEL_SIZE, copied)
+                .putString(KEY_MODEL_SHA256, sha256)
+                .commit();
+        state = State.NOT_CONFIGURED;
+        lastError = "";
+        String error = ensureLoadedOnWorker();
+        if (!error.isEmpty()) {
+            postLoadError(callback, error);
+            return;
+        }
+        String verification = RECOMMENDED_MODEL_SHA256.equalsIgnoreCase(sha256)
+                ? "Official Qwen model verified. "
+                : "Custom GGUF imported. ";
+        postLoadReady(
+                callback,
+                verification
+                        + modelSummary()
+                        + " You can delete the original downloaded copy to reclaim storage."
+        );
+    }
