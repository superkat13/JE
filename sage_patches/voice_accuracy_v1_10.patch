+                "scroll", "tap", "click", "press", "pick", "choose", "select", "type",
+                "write", "volume", "louder", "quieter", "mute", "pause", "play", "next",
+                "previous", "notification", "remember", "memory", "red", "queen", "sleep",
+                "help", "first", "second", "third", "fourth", "fifth", "sixth", "seventh",
+                "eighth", "ninth", "tenth", "video", "link", "result", "website", "settings"
+        };
+        for (String cue : cues) {
+            if (padded.contains(" " + cue + " ")) {
+                return true;
+            }
+        }
+        return false;
