@@ -0,0 +1,209 @@
+package com.pineapple.sage;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.os.Build;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+public final class SageDiagnostics {
+    private static final String PREFS_NAME = "sage_diagnostics";
+    private static final String KEY_EVENT_LOG = "event_log";
+    private static final String KEY_STATE = "state";
+    private static final String KEY_LISTENER = "listener";
+    private static final String KEY_LAST_HEARD = "last_heard";
+    private static final String KEY_LAST_ERROR = "last_error";
+    private static final String KEY_MIC_LEVEL = "mic_level";
+    private static final String KEY_WAKE_STARTS = "wake_starts";
+    private static final String KEY_COMMAND_STARTS = "command_starts";
+    private static final String KEY_SILENCE_CLOSES = "silence_closes";
+    private static final String KEY_BUSY_RETRIES = "busy_retries";
+    private static final String KEY_STALE_CALLBACKS = "stale_callbacks";
+    private static final String KEY_ECHO_REJECTIONS = "echo_rejections";
+    private static final int MAX_LOG_CHARS = 12000;
+    private static final Object LOCK = new Object();
+
+    private static long lastMicWriteAtMs;
+    private static float lastMicLevel = Float.NaN;
+
+    private SageDiagnostics() {
+    }
+
+    public static void recordState(Context context, String state, String listener) {
+        SharedPreferences preferences = preferences(context);
+        String cleanedState = safe(state);
+        String cleanedListener = listener == null ? null : safe(listener);
+        String previousState = preferences.getString(KEY_STATE, "");
+        String previousListener = preferences.getString(KEY_LISTENER, "");
+        SharedPreferences.Editor editor = preferences.edit()
+                .putString(KEY_STATE, cleanedState);
+        if (listener != null) {
+            editor.putString(KEY_LISTENER, cleanedListener);
+        }
+        editor.apply();
+        if (!cleanedState.equals(previousState)
+                || (cleanedListener != null && !cleanedListener.equals(previousListener))) {
+            appendEvent(context, "STATE", cleanedState);
+        }
+    }
+
+    public static void recordHeard(Context context, String heard) {
+        String cleaned = safe(heard).trim();
+        if (cleaned.length() > 160) {
+            cleaned = cleaned.substring(0, 160) + "…";
+        }
+        preferences(context).edit().putString(KEY_LAST_HEARD, cleaned).apply();
+    }
+
+    public static void recordError(Context context, String error) {
+        String cleaned = safe(error);
+        preferences(context).edit().putString(KEY_LAST_ERROR, cleaned).apply();
+        appendEvent(context, "ERROR", cleaned);
+    }
+
+    public static void recordMicLevel(Context context, float rmsDb) {
+        long now = System.currentTimeMillis();
+        if (now - lastMicWriteAtMs < 500L
+                && !Float.isNaN(lastMicLevel)
+                && Math.abs(rmsDb - lastMicLevel) < 2.0f) {
+            return;
+        }
+        lastMicWriteAtMs = now;
+        lastMicLevel = rmsDb;
+        preferences(context).edit()
+                .putFloat(KEY_MIC_LEVEL, rmsDb)
+                .apply();
+    }
+
+    public static void wakeStarted(Context context, String detail) {
+        increment(context, KEY_WAKE_STARTS);
+        preferences(context).edit().putString(KEY_LISTENER, "Offline wake word").apply();
+        appendEvent(context, "WAKE", detail);
+    }
+
+    public static void commandStarted(Context context, String detail) {
+        increment(context, KEY_COMMAND_STARTS);
+        preferences(context).edit().putString(KEY_LISTENER, "Android command turn").apply();
+        appendEvent(context, "COMMAND", detail);
+    }
+
+    public static void silenceClosedTurn(Context context, String detail) {
+        increment(context, KEY_SILENCE_CLOSES);
+        appendEvent(context, "SILENCE", detail);
+    }
+
+    public static void busyRetry(Context context, String detail) {
+        increment(context, KEY_BUSY_RETRIES);
+        appendEvent(context, "BUSY", detail);
+    }
+
+    public static void staleCallbackIgnored(Context context, String detail) {
+        increment(context, KEY_STALE_CALLBACKS);
+        appendEvent(context, "STALE", detail);
+    }
+
+    public static void echoRejected(Context context, String detail) {
+        increment(context, KEY_ECHO_REJECTIONS);
+        appendEvent(context, "ECHO", detail);
+    }
+
+    public static void appendEvent(Context context, String category, String detail) {
+        synchronized (LOCK) {
+            SharedPreferences preferences = preferences(context);
+            String existing = preferences.getString(KEY_EVENT_LOG, "");
+            String line = timestamp() + "  " + safe(category) + "  " + safe(detail);
+            String updated = existing == null || existing.isEmpty()
+                    ? line
+                    : existing + "\n" + line;
+            if (updated.length() > MAX_LOG_CHARS) {
+                updated = updated.substring(updated.length() - MAX_LOG_CHARS);
+                int firstBreak = updated.indexOf('\n');
+                if (firstBreak >= 0 && firstBreak + 1 < updated.length()) {
+                    updated = updated.substring(firstBreak + 1);
+                }
+            }
+            preferences.edit().putString(KEY_EVENT_LOG, updated).apply();
+        }
+    }
+
+    public static String buildSummary(Context context) {
+        SharedPreferences preferences = preferences(context);
+        String state = preferences.getString(KEY_STATE, "Not started");
+        String listener = preferences.getString(KEY_LISTENER, "None");
+        String heard = preferences.getString(KEY_LAST_HEARD, "");
+        String error = preferences.getString(KEY_LAST_ERROR, "");
+        float mic = preferences.getFloat(KEY_MIC_LEVEL, 0.0f);
+        return "State: " + state
+                + "\nListener: " + listener
+                + "\nMic level: " + String.format(Locale.US, "%.1f dB", mic)
+                + "\nLast heard: " + (heard == null || heard.isEmpty() ? "Nothing yet" : heard)
+                + "\nLast error: " + (error == null || error.isEmpty() ? "None" : error)
+                + "\nWake starts: " + preferences.getInt(KEY_WAKE_STARTS, 0)
+                + "  •  Command turns: " + preferences.getInt(KEY_COMMAND_STARTS, 0)
+                + "\nSilent turns closed: " + preferences.getInt(KEY_SILENCE_CLOSES, 0)
+                + "  •  Busy retries: " + preferences.getInt(KEY_BUSY_RETRIES, 0)
+                + "\nStale callbacks blocked: " + preferences.getInt(KEY_STALE_CALLBACKS, 0)
+                + "  •  Echoes rejected: " + preferences.getInt(KEY_ECHO_REJECTIONS, 0);
+    }
+
+    public static String buildReport(Context context) {
+        SharedPreferences appPreferences =
+                context.getSharedPreferences("sage_state", Context.MODE_PRIVATE);
+        String version = "unknown";
+        try {
+            PackageInfo info = context.getPackageManager()
+                    .getPackageInfo(context.getPackageName(), 0);
+            long code = Build.VERSION.SDK_INT >= Build.VERSION_CODES.P
+                    ? info.getLongVersionCode()
+                    : info.versionCode;
+            version = info.versionName + " (" + code + ")";
+        } catch (Exception ignored) {
+        }
+        SharedPreferences preferences = preferences(context);
+        String events = preferences.getString(KEY_EVENT_LOG, "");
+        return "Sage diagnostic report\n"
+                + "Created: " + timestamp() + "\n"
+                + "Version: " + version + "\n"
+                + "Package: " + context.getPackageName() + "\n"
+                + "Device: " + Build.MANUFACTURER + " " + Build.MODEL + "\n"
+                + "Android: " + Build.VERSION.RELEASE + " (API " + Build.VERSION.SDK_INT + ")\n"
+                + "Conversation mode: "
+                + (appPreferences.getBoolean("conversation_mode_enabled", true) ? "on" : "off")
+                + "\n\nCurrent snapshot\n"
+                + buildSummary(context)
+                + "\n\nRecent microphone events\n"
+                + (events == null || events.isEmpty() ? "No events recorded." : events);
+    }
+
+    public static void clear(Context context) {
+        synchronized (LOCK) {
+            preferences(context).edit().clear().apply();
+            lastMicWriteAtMs = 0L;
+            lastMicLevel = Float.NaN;
+        }
+    }
+
+    private static void increment(Context context, String key) {
+        synchronized (LOCK) {
+            SharedPreferences preferences = preferences(context);
+            int value = preferences.getInt(key, 0);
+            preferences.edit().putInt(key, value + 1).apply();
+        }
+    }
+
+    private static SharedPreferences preferences(Context context) {
+        return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    private static String timestamp() {
+        return new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.US)
+                .format(new Date());
+    }
+
+    private static String safe(String value) {
+        return value == null ? "" : value.replace('\n', ' ').trim();
+    }
+}
