+    private void askOnWorker(String cleaned, ReplyCallback callback) {
+        postReplyStatus(callback, isReady()
+                ? "Sage Brain is thinking"
+                : "Loading Sage Brain for this request");
+        boolean loadRequired = !isReady();
+        if (loadRequired) SageBrainHealth.loadStarted(context);
+        String loadError = ensureLoadedOnWorker();
+        if (!loadError.isEmpty()) {
+            postReplyError(callback, loadError);
+            return;
+        }
+        if (loadRequired) SageBrainHealth.loadFinished(context);
+        postReplyStatus(callback, "Generating local Brain response");
+        SageBrainHealth.promptStarted(context);
+        String systemPrompt = buildSystemPrompt();
+        String userPrompt = buildUserPrompt(cleaned);
+        String raw;
+        try {
+            raw = nativeGenerate(systemPrompt, userPrompt, MAX_REPLY_TOKENS);
+        } catch (Throwable problem) {
+            raw = "";
+            lastError = "Brain generation failed: " + safeProblem(problem);
+        }
+        if (raw == null || raw.trim().isEmpty()) {
+            String error = nativeErrorOr("The local model did not return an answer.")
+                    + " [stage=" + lastNativeStage() + ", generated_tokens="
+                    + lastGeneratedTokenCount() + "]";
+            state = State.ERROR;
+            status = error;
+            lastError = error;
+            SageBrainHealth.setStatus(context, SageBrainHealth.Status.ERROR,
+                    "tablet Brain", lastNativeStage(), error);
+            postReplyError(callback, error);
+            return;
+        }
+        Reply reply = parseReply(cleaned, raw);
+        if (reply.text.isEmpty()) {
+            postReplyError(callback, "The local model returned an unreadable answer. [stage="
+                    + lastNativeStage() + "]");
+            return;
+        }
+        rememberTurn("User: " + cleaned);
+        rememberTurn("Sage: " + reply.text);
+        SageBrainHealth.generationFinished(context, reply.text,
+                nativeLastFirstTokenLatencyMs(), nativeLastGeneratedTokenCount(),
+                nativeLastGenerationDurationMs());
+        postReply(callback, reply);
+    }
