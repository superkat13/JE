+    private static ScreenTarget resolveCurrentTarget(
+            ScreenTarget saved,
+            List<ScreenTarget> currentTargets,
+            int screenWidth
+    ) {
+        if (saved == null || currentTargets == null || currentTargets.isEmpty()) {
+            return null;
