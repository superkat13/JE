+                score += 120;
+            } else if (savedText.length() >= 5
+                    && currentText.length() >= 5
+                    && (savedText.contains(currentText) || currentText.contains(savedText))) {
+                score += 70;
+            }
+            Rect overlap = new Rect(saved.bounds);
+            if (overlap.intersect(current.bounds)) {
+                score += 45;
+            }
+            int distance = Math.abs(saved.bounds.centerX() - current.bounds.centerX())
+                    + Math.abs(saved.bounds.centerY() - current.bounds.centerY());
+            if (distance <= nearbyDistance) {
+                score += 35;
+            } else if (distance <= nearbyDistance * 2) {
+                score += 15;
+            }
+            if (score > bestScore) {
