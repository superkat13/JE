diff --git a/sage_build_1333_new/app/src/test/java/com/pineapple/sage/SageTypedCommandQueueTest.java b/app/src/test/java/com/pineapple/sage/SageTypedCommandQueueTest.java
new file mode 100644
index 0000000..e402a90
--- /dev/null
+++ b/app/src/test/java/com/pineapple/sage/SageTypedCommandQueueTest.java
@@ -0,0 +1,46 @@
+package com.pineapple.sage;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import org.junit.Test;
+
+public class SageTypedCommandQueueTest {
+    @Test
+    public void preservesTypedMessagesInArrivalOrder() {
+        SageTypedCommandQueue queue = new SageTypedCommandQueue(3);
+
+        assertEquals(SageTypedCommandQueue.OfferResult.QUEUED, queue.offer(" first "));
+        assertEquals(SageTypedCommandQueue.OfferResult.QUEUED, queue.offer("second"));
+        assertEquals("first", queue.poll());
+        assertEquals("second", queue.poll());
+        assertNull(queue.poll());
+    }
+
+    @Test
+    public void neverSilentlyOverwritesAQueuedMessage() {
+        SageTypedCommandQueue queue = new SageTypedCommandQueue(2);
+
+        assertEquals(SageTypedCommandQueue.OfferResult.QUEUED, queue.offer("one"));
+        assertEquals(SageTypedCommandQueue.OfferResult.QUEUED, queue.offer("two"));
+        assertEquals(SageTypedCommandQueue.OfferResult.FULL, queue.offer("three"));
+        assertEquals("one", queue.poll());
+        assertEquals("two", queue.poll());
+    }
+
+    @Test
+    public void ignoresBlankInputAndCanBeCleared() {
+        SageTypedCommandQueue queue = new SageTypedCommandQueue(2);
+
+        assertEquals(SageTypedCommandQueue.OfferResult.EMPTY, queue.offer("  "));
+        assertEquals(SageTypedCommandQueue.OfferResult.EMPTY, queue.offer(null));
+        assertEquals(SageTypedCommandQueue.OfferResult.QUEUED, queue.offer("kept"));
+        queue.clear();
+        assertNull(queue.poll());
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void rejectsInvalidCapacity() {
+        new SageTypedCommandQueue(0);
+    }
+}
