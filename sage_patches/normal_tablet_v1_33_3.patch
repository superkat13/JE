@@ -0,0 +1,45 @@
+package com.pineapple.sage;
+
+import java.util.ArrayDeque;
+
+final class SageTypedCommandQueue {
+    enum OfferResult {
+        QUEUED,
+        EMPTY,
+        FULL
+    }
+
+    private final ArrayDeque<String> commands = new ArrayDeque<>();
+    private final int capacity;
+
+    SageTypedCommandQueue(int capacity) {
+        if (capacity < 1) {
+            throw new IllegalArgumentException("capacity must be positive");
+        }
+        this.capacity = capacity;
+    }
+
+    OfferResult offer(String command) {
+        String cleaned = command == null ? "" : command.trim();
+        if (cleaned.isEmpty()) {
+            return OfferResult.EMPTY;
+        }
+        if (commands.size() >= capacity) {
+            return OfferResult.FULL;
+        }
+        commands.addLast(cleaned);
+        return OfferResult.QUEUED;
+    }
+
+    String poll() {
+        return commands.pollFirst();
+    }
+
+    int size() {
+        return commands.size();
+    }
+
+    void clear() {
+        commands.clear();
+    }
+}
