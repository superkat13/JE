@@ -0,0 +1,30 @@
+package com.pineapple.sage;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+import org.junit.Test;
+
+public final class SageBrainConversationRepairTest {
+    @Test public void finishYourThoughtCarriesTheLatestExchange() {
+        SageBrainRequestPolicy.Prompt prompt = SageBrainRequestPolicy.build(
+                "finish your thought", "normal",
+                Arrays.asList("User: Tell me about the repair.",
+                        "Sage: The repair includes three important"),
+                Collections.emptyList(), 30000L, 2.0f);
+        assertEquals(SageBrainRequestPolicy.PromptMode.CONVERSATIONAL, prompt.mode);
+        assertTrue(prompt.user.contains("The repair includes three important"));
+        assertTrue(prompt.system.contains("Never stop mid-sentence"));
+    }
+
+    @Test public void normalAnswersHaveAUsefulCompletionBudget() {
+        SageBrainRequestPolicy.Prompt prompt = SageBrainRequestPolicy.build(
+                "Tell me something useful", "normal",
+                Collections.emptyList(), Collections.emptyList(), 30000L, 2.0f);
+        assertTrue(prompt.outputTokens > 16);
+        assertTrue(prompt.outputTokens <= 48);
+    }
+}
