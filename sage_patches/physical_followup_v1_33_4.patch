+package com.pineapple.sage;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public final class SageConversationRepairPolicyTest {
+    @Test public void routesObservedCapabilityParaphrasesDeterministically() {
+        assertTrue(SageConversationRepairPolicy.isCapabilityQuestion(
+                "What all capabilities do you have?"));
+        assertTrue(SageConversationRepairPolicy.isCapabilityQuestion(
+                "Trying to hold a conversation with you. What all can you do?"));
+        assertTrue(SageConversationRepairPolicy.isCapabilityQuestion(
+                "Show your capabilities"));
+    }
+
+    @Test public void ordinaryConversationDoesNotOpenCapabilitySnapshot() {
+        assertFalse(SageConversationRepairPolicy.isCapabilityQuestion(
+                "What do you think about this?"));
+        assertFalse(SageConversationRepairPolicy.isCapabilityQuestion("Hello Sage"));
+    }
+}
