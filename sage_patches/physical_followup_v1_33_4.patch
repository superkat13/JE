+    static String recoverySuffix(String phraseInput) {
+        String phrase = normalizePhrase(phraseInput);
+        String[] prefixes = {"okay sage ", "hey sage ", "ok sage ", "sage "};
+        for (String prefix : prefixes) {
+            if (!phrase.startsWith(prefix)) {
+                continue;
+            }
+            String suffix = phrase.substring(prefix.length()).trim();
+            if (suffix.length() < 4 || suffix.split(" ").length > 3) {
+                return "";
+            }
+            if (suffix.split(" ").length == 1 && UNSAFE_SINGLE_WORDS.contains(suffix)) {
+                return "";
+            }
+            return suffix;
+        }
+        return "";
+    }
