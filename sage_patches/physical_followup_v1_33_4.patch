@@ -0,0 +1,28 @@
+package com.pineapple.sage;
+
+import java.util.Locale;
+
+/** Natural-language repair rules that must run before generic Brain fallback. */
+final class SageConversationRepairPolicy {
+    private SageConversationRepairPolicy() {}
+
+    static boolean isCapabilityQuestion(String raw) {
+        String value = normalize(raw);
+        return value.equals("sage capability status")
+                || value.contains("what can you do")
+                || value.contains("what all can you do")
+                || value.contains("what can you use")
+                || value.contains("what all can you use")
+                || value.contains("what capabilities do you have")
+                || value.contains("what all capabilities do you have")
+                || value.contains("list your capabilities")
+                || value.contains("show your capabilities");
+    }
+
+    private static String normalize(String value) {
+        return value == null ? "" : value.toLowerCase(Locale.US)
+                .replaceAll("[^a-z0-9]+", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+}
