diff --git a/app/src/main/java/com/pineapple/sage/SageWakeFragmentTracker.java b/app/src/main/java/com/pineapple/sage/SageWakeFragmentTracker.java
new file mode 100644
index 0000000..9ded304
--- /dev/null
+++ b/app/src/main/java/com/pineapple/sage/SageWakeFragmentTracker.java
@@ -0,0 +1,56 @@
+package com.pineapple.sage;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/** Rejoins only a bounded wake prefix and Sage-like suffix split by Vosk. */
+final class SageWakeFragmentTracker {
+    static final long FRAGMENT_WINDOW_MS = 2500L;
+    private static final Set<String> PREFIXES = new HashSet<>(
+            Arrays.asList("hey", "okay", "ok"));
+    private static final Set<String> SAGE_SUFFIXES = new HashSet<>(
+            Arrays.asList("sage", "stage", "safe", "save", "say", "age", "page"));
+
+    private String heldPrefix = "";
+    private long heldAtMs;
+
+    synchronized String resolve(String raw, boolean finalResult, long nowMs) {
+        String value = normalize(raw);
+        if (!finalResult) {
+            return value;
+        }
+        if (!heldPrefix.isEmpty() && nowMs - heldAtMs > FRAGMENT_WINDOW_MS) {
+            reset();
+        }
+        if (PREFIXES.contains(value)) {
+            heldPrefix = value;
+            heldAtMs = nowMs;
+            return "";
+        }
+        if (!heldPrefix.isEmpty() && SAGE_SUFFIXES.contains(value)) {
+            String combined = heldPrefix + " " + value;
+            reset();
+            return combined;
+        }
+        reset();
+        return value;
+    }
+
+    synchronized boolean isHolding() {
+        return !heldPrefix.isEmpty();
+    }
+
+    synchronized void reset() {
+        heldPrefix = "";
+        heldAtMs = 0L;
+    }
+
+    private static String normalize(String value) {
+        return value == null ? "" : value.toLowerCase(Locale.US)
+                .replaceAll("[^a-z0-9]+", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+}
