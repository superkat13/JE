@@ -0,0 +1,32 @@
+package com.pineapple.sage;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public final class SageWakeFragmentTrackerTest {
+    @Test public void combinesOnlyRecentPrefixAndSageLikeSuffix() {
+        SageWakeFragmentTracker tracker = new SageWakeFragmentTracker();
+        assertEquals("", tracker.resolve("okay", true, 1000L));
+        assertTrue(tracker.isHolding());
+        assertEquals("okay age", tracker.resolve("age", true, 2200L));
+        assertFalse(tracker.isHolding());
+    }
+
+    @Test public void expiredOrStandaloneSuffixNeverBecomesAWakePhrase() {
+        SageWakeFragmentTracker tracker = new SageWakeFragmentTracker();
+        assertEquals("age", tracker.resolve("age", true, 1000L));
+        assertEquals("", tracker.resolve("okay", true, 2000L));
+        assertEquals("save", tracker.resolve("save", true, 5001L));
+        assertFalse(tracker.isHolding());
+    }
+
+    @Test public void unrelatedSpeechClearsPendingPrefix() {
+        SageWakeFragmentTracker tracker = new SageWakeFragmentTracker();
+        assertEquals("", tracker.resolve("hey", true, 1000L));
+        assertEquals("weather", tracker.resolve("weather", true, 1200L));
+        assertEquals("page", tracker.resolve("page", true, 1300L));
+    }
+}
