+            if (NATIVE_AVAILABLE) nativeUnloadModel();
+            try {
+                Files.move(verified.toPath(), modelFile().toPath(),
+                        StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+            } catch (Exception first) {
+                try {
+                    Files.move(verified.toPath(), modelFile().toPath(),
+                            StandardCopyOption.REPLACE_EXISTING);
+                } catch (Exception second) {
+                    postLoadError(callback, "Verified model could not be activated: "
+                            + safeProblem(second));
+                    return;
+                }
+            }
+            preferences.edit().putBoolean(KEY_ENABLED, true).putString(KEY_MODEL_NAME, name)
