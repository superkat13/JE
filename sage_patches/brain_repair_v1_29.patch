--- sage_build_129_base/app/src/main/java/com/pineapple/sage/SageModelManager.java	1969-12-31 18:00:00.000000000 -0600
+++ sage_build_129/app/src/main/java/com/pineapple/sage/SageModelManager.java	2026-08-08 18:50:40.892164746 -0500
@@ -0,0 +1,150 @@
+package com.pineapple.sage;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.security.MessageDigest;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Owner-started, resumable and exactly verified model catalog download. */
+final class SageModelManager {
+    interface Callback {
+        void onProgress(String value);
+        void onReady(String value);
+        void onError(String value);
+    }
+
+    private static final long STORAGE_HEADROOM = 256L * 1024L * 1024L;
+    private final SageBrainManager brain;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final AtomicBoolean cancelled = new AtomicBoolean(false);
+
+    SageModelManager(Context context, SageBrainManager brain) { this.brain = brain; }
+
+    void downloadRecommended(Callback callback) {
+        cancelled.set(false);
+        worker.execute(() -> download(callback));
+    }
+
+    void cancel() { cancelled.set(true); }
+
+    private void download(Callback callback) {
+        File directory = brain.downloadDirectory();
+        if (!directory.exists() && !directory.mkdirs()) {
+            error(callback, "Model download failed: private model directory is unavailable.");
+            return;
+        }
+        File partial = new File(directory, "recommended-model.gguf.part");
+        long existing = partial.isFile() ? partial.length() : 0L;
+        long remaining = Math.max(0L, SageBrainManager.RECOMMENDED_MODEL_BYTES - existing);
+        long required = remaining + STORAGE_HEADROOM;
+        if (brain.freeStorageBytes() < required) {
+            error(callback, "Model download needs " + format(required)
+                    + " free including verification headroom; available "
+                    + format(brain.freeStorageBytes()) + ".");
+            return;
+        }
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(
+                    SageBrainManager.RECOMMENDED_MODEL_URL).openConnection();
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(30000);
+            connection.setInstanceFollowRedirects(true);
+            if (existing > 0L) connection.setRequestProperty("Range", "bytes=" + existing + "-");
+            int response = connection.getResponseCode();
+            boolean resumed = existing > 0L && response == HttpURLConnection.HTTP_PARTIAL;
+            if (existing > 0L && !resumed) {
+                existing = 0L;
+                if (!partial.delete()) throw new IllegalStateException("stale partial download could not be reset");
+            }
+            if (response != HttpURLConnection.HTTP_OK
+                    && response != HttpURLConnection.HTTP_PARTIAL) {
+                throw new IllegalStateException("HTTPS response " + response);
+            }
+            long total = existing + Math.max(0L, connection.getContentLengthLong());
+            if (total != SageBrainManager.RECOMMENDED_MODEL_BYTES) {
+                throw new IllegalStateException("catalog size "
+                        + SageBrainManager.RECOMMENDED_MODEL_BYTES + " bytes but server reported "
+                        + total + " bytes");
+            }
+            progress(callback, resumed ? "Resuming verified model download" : "Starting verified model download");
+            try (InputStream input = connection.getInputStream();
+                 FileOutputStream output = new FileOutputStream(partial, resumed)) {
+                byte[] buffer = new byte[1024 * 1024];
+                long copied = existing;
+                int lastPercent = -1;
+                int count;
+                while ((count = input.read(buffer)) >= 0) {
+                    if (cancelled.get()) {
+                        progress(callback, "Model download cancelled; partial file retained for resume.");
+                        return;
+                    }
+                    if (count == 0) continue;
+                    output.write(buffer, 0, count);
+                    copied += count;
+                    int percent = (int) Math.min(100L,
+                            copied * 100L / SageBrainManager.RECOMMENDED_MODEL_BYTES);
+                    if (percent != lastPercent) {
+                        lastPercent = percent;
+                        progress(callback, "Downloading model: " + percent + "% ("
+                                + format(copied) + " / "
+                                + format(SageBrainManager.RECOMMENDED_MODEL_BYTES) + ")");
+                    }
+                }
+                output.getFD().sync();
+            }
+            if (partial.length() != SageBrainManager.RECOMMENDED_MODEL_BYTES) {
+                throw new IllegalStateException("download ended at " + partial.length() + " bytes");
+            }
+            progress(callback, "Download complete; verifying exact SHA-256");
+            String hash = sha256(partial);
+            if (!SageBrainManager.RECOMMENDED_MODEL_SHA256.equalsIgnoreCase(hash)) {
+                partial.delete();
+                throw new SecurityException("SHA-256 mismatch; received " + hash);
+            }
+            brain.installVerifiedDownloadAsync(partial, SageBrainManager.RECOMMENDED_MODEL_NAME,
+                    SageBrainManager.RECOMMENDED_MODEL_BYTES, hash,
+                    new SageBrainManager.LoadCallback() {
+                        @Override public void onStatus(String value) { progress(callback, value); }
+                        @Override public void onReady(String value) { ready(callback, value); }
+                        @Override public void onError(String value) { error(callback, value); }
+                    });
+        } catch (Exception problem) {
+            error(callback, "Model download failed: " + problem.getClass().getSimpleName()
+                    + ": " + String.valueOf(problem.getMessage()));
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    private static String sha256(File file) throws Exception {
+        MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        try (FileInputStream input = new FileInputStream(file)) {
+            byte[] buffer = new byte[1024 * 1024];
+            int count;
+            while ((count = input.read(buffer)) >= 0) if (count > 0) digest.update(buffer, 0, count);
+        }
+        StringBuilder value = new StringBuilder();
+        for (byte item : digest.digest()) value.append(String.format(Locale.US, "%02x", item));
+        return value.toString();
+    }
+
+    private void progress(Callback callback, String value) { main.post(() -> callback.onProgress(value)); }
+    private void ready(Callback callback, String value) { main.post(() -> callback.onReady(value)); }
+    private void error(Callback callback, String value) { main.post(() -> callback.onError(value)); }
+    private static String format(long bytes) {
+        return String.format(Locale.US, "%.2f GB", bytes / (1024.0 * 1024.0 * 1024.0));
+    }
+}
